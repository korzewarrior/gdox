+GdoxNbdDiscImageReader::CacheLine* GdoxNbdDiscImageReader::FindCacheLine(
+    size_t offset) {
+  for (CacheLine& line : cache_) {
+    if (line.length != 0 && line.offset == offset) {
+      line.last_used = ++cache_clock_;
+      return &line;
+    }
+  }
+  return nullptr;
+}
+
+GdoxNbdDiscImageReader::CacheLine* GdoxNbdDiscImageReader::SelectCacheLine() {
+  CacheLine* oldest = &cache_.front();
+  for (CacheLine& line : cache_) {
+    if (line.length == 0) {
+      return &line;
+    }
+    if (line.last_used < oldest->last_used) {
+      oldest = &line;
+    }
+  }
+  return oldest;
+}
+
+bool GdoxNbdDiscImageReader::FillCacheLine(size_t offset, size_t image_size,
+                                           CacheLine** output) {
+  if (!output || offset >= image_size) {
+    return false;
+  }
+  CacheLine* line = SelectCacheLine();
+  const size_t length = std::min(kCacheLineBytes, image_size - offset);
+  line->length = 0;
+  line->data.resize(length);
+  if (!ReadChunk(uint64_t(offset), line->data.data(), uint32_t(length))) {
+    return false;
+  }
+  line->offset = offset;
+  line->length = length;
+  line->last_used = ++cache_clock_;
+  *output = line;
+  return true;
+}
