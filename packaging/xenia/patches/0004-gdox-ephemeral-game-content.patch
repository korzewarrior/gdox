diff --git a/src/xenia/base/gdox_storage_capability.h b/src/xenia/base/gdox_storage_capability.h
new file mode 100644
--- /dev/null
+++ b/src/xenia/base/gdox_storage_capability.h
@@ -0,0 +1,35 @@
+/**
+ ******************************************************************************
+ * Xenia : Xbox 360 Emulator Research Project                                 *
+ ******************************************************************************
+ * Copyright 2026 GDOX contributors.                                         *
+ * Released under the BSD license - see LICENSE in the root for more details. *
+ ******************************************************************************
+ */
+
+#ifndef XENIA_BASE_GDOX_STORAGE_CAPABILITY_H_
+#define XENIA_BASE_GDOX_STORAGE_CAPABILITY_H_
+
+#include <cstring>
+#include <cwchar>
+
+namespace xe {
+
+inline constexpr char kGdoxStorageCapabilityResponse[] =
+    "{\"schema\":1,\"runtime\":\"xenia\",\"storage\":{"
+    "\"persistent\":\"saves-profiles-only\","
+    "\"game_content\":\"ephemeral\"}}\n";
+
+inline bool IsGdoxStorageCapabilityQuery(int argc, char* const* argv) {
+  return argc == 2 && argv != nullptr && argv[1] != nullptr &&
+         std::strcmp(argv[1], "--gdox-storage-capabilities") == 0;
+}
+
+inline bool IsGdoxStorageCapabilityQuery(const wchar_t* command_line) {
+  return command_line != nullptr &&
+         std::wcscmp(command_line, L"--gdox-storage-capabilities") == 0;
+}
+
+}  // namespace xe
+
+#endif  // XENIA_BASE_GDOX_STORAGE_CAPABILITY_H_
diff --git a/src/xenia/ui/windowed_app_main_posix.cc b/src/xenia/ui/windowed_app_main_posix.cc
--- a/src/xenia/ui/windowed_app_main_posix.cc
+++ b/src/xenia/ui/windowed_app_main_posix.cc
@@ -11,10 +11,16 @@
 #include <cstdlib>
 
 #include "xenia/base/cvar.h"
+#include "xenia/base/gdox_storage_capability.h"
 #include "xenia/base/logging.h"
 #include "xenia/ui/windowed_app.h"
 #include "xenia/ui/windowed_app_context_gtk.h"
 
 int main(int argc_pre_gtk, char** argv_pre_gtk) {
+  if (xe::IsGdoxStorageCapabilityQuery(argc_pre_gtk, argv_pre_gtk)) {
+    std::fputs(xe::kGdoxStorageCapabilityResponse, stdout);
+    return EXIT_SUCCESS;
+  }
+
   // Before touching anything GTK+, make sure that when running on Wayland,
   // we'll still get an X11 (Xwayland) window
diff --git a/src/xenia/ui/windowed_app_main_win.cc b/src/xenia/ui/windowed_app_main_win.cc
--- a/src/xenia/ui/windowed_app_main_win.cc
+++ b/src/xenia/ui/windowed_app_main_win.cc
@@ -12,3 +12,4 @@
 #include "xenia/base/console.h"
 #include "xenia/base/cvar.h"
+#include "xenia/base/gdox_storage_capability.h"
 #include "xenia/base/main_win.h"
@@ -309,3 +310,17 @@ int UnhandledExceptionFilterThunk(_EXCEPTION_POINTERS* exception_info) {
 int WINAPI wWinMain(HINSTANCE hinstance, HINSTANCE hinstance_prev,
                     LPWSTR command_line, int show_cmd) {
+  if (xe::IsGdoxStorageCapabilityQuery(command_line)) {
+    HANDLE output = GetStdHandle(STD_OUTPUT_HANDLE);
+    DWORD written = 0;
+    const DWORD response_size = static_cast<DWORD>(
+        sizeof(xe::kGdoxStorageCapabilityResponse) - 1);
+    if (output == nullptr || output == INVALID_HANDLE_VALUE ||
+        !WriteFile(output, xe::kGdoxStorageCapabilityResponse, response_size,
+                   &written, nullptr) ||
+        written != response_size) {
+      return EXIT_FAILURE;
+    }
+    return EXIT_SUCCESS;
+  }
+
   MODULEINFO modinfo;
