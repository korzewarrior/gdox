@@ -0,0 +1,114 @@
+/**
+ ******************************************************************************
+ * Xenia : Xbox 360 Emulator Research Project                                 *
+ ******************************************************************************
+ * Copyright 2026 Signal Spike Games. All rights reserved.                    *
+ * Released under the BSD license - see LICENSE in the root for more details. *
+ ******************************************************************************
+ */
+
+#include "xenia/vfs/devices/gdox_nbd_stream.h"
+
+#include <arpa/inet.h>
+#include <errno.h>
+#include <sys/socket.h>
+#include <unistd.h>
+
+#include <algorithm>
+#include <limits>
+
+namespace xe {
+namespace vfs {
+
+constexpr int kGdoxNbdIoTimeoutSeconds = 30;
+
+class PosixGdoxNbdStream final : public GdoxNbdStream {
+ public:
+  explicit PosixGdoxNbdStream(int socket) : socket_(socket) {}
+  ~PosixGdoxNbdStream() override { Close(); }
+
+  bool ReadExact(void* buffer, size_t length) override {
+    auto output = static_cast<uint8_t*>(buffer);
+    size_t completed = 0;
+    while (completed < length) {
+      size_t request = std::min(length - completed,
+                                size_t(std::numeric_limits<ssize_t>::max()));
+      ssize_t received = recv(socket_, output + completed, request, 0);
+      if (received > 0) {
+        completed += size_t(received);
+      } else if (received == 0) {
+        Close();
+        return false;
+      } else if (errno != EINTR) {
+        Close();
+        return false;
+      }
+    }
+    return true;
+  }
+
+  bool WriteAll(const void* buffer, size_t length) override {
+    auto input = static_cast<const uint8_t*>(buffer);
+    size_t completed = 0;
+    while (completed < length) {
+      size_t request = std::min(length - completed,
+                                size_t(std::numeric_limits<ssize_t>::max()));
+#ifdef MSG_NOSIGNAL
+      ssize_t sent = send(socket_, input + completed, request, MSG_NOSIGNAL);
+#else
+      ssize_t sent = send(socket_, input + completed, request, 0);
+#endif
+      if (sent > 0) {
+        completed += size_t(sent);
+      } else if (sent == 0) {
+        Close();
+        return false;
+      } else if (errno != EINTR) {
+        Close();
+        return false;
+      }
+    }
+    return true;
+  }
+
+  void Close() override {
+    if (socket_ >= 0) {
+      int socket = socket_;
+      socket_ = -1;
+      shutdown(socket, SHUT_RDWR);
+      close(socket);
+    }
+  }
+
+ private:
+  int socket_ = -1;
+};
+
+std::unique_ptr<GdoxNbdStream> GdoxNbdStream::ConnectLoopback(uint16_t port) {
+  int socket_handle = socket(AF_INET, SOCK_STREAM, IPPROTO_TCP);
+  if (socket_handle < 0) {
+    return nullptr;
+  }
+  sockaddr_in address = {};
+  address.sin_family = AF_INET;
+  address.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+  address.sin_port = htons(port);
+  if (connect(socket_handle, reinterpret_cast<const sockaddr*>(&address),
+              sizeof(address)) != 0) {
+    close(socket_handle);
+    return nullptr;
+  }
+  timeval timeout = {};
+  timeout.tv_sec = kGdoxNbdIoTimeoutSeconds;
+  if (setsockopt(socket_handle, SOL_SOCKET, SO_RCVTIMEO, &timeout,
+                 sizeof(timeout)) != 0 ||
+      setsockopt(socket_handle, SOL_SOCKET, SO_SNDTIMEO, &timeout,
+                 sizeof(timeout)) != 0) {
+    close(socket_handle);
+    return nullptr;
+  }
+  return std::make_unique<PosixGdoxNbdStream>(socket_handle);
+}
+
+}  // namespace vfs
+}  // namespace xe
