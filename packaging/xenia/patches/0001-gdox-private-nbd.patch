diff --git a/src/xenia/vfs/devices/gdox_nbd_reader.cc b/src/xenia/vfs/devices/gdox_nbd_reader.cc
new file mode 100644
index 00000000..cdb04ca2
--- /dev/null
+++ b/src/xenia/vfs/devices/gdox_nbd_reader.cc
@@ -0,0 +1,271 @@
+/**
+ ******************************************************************************
+ * Xenia : Xbox 360 Emulator Research Project                                 *
+ ******************************************************************************
+ * Copyright 2026 Signal Spike Games. All rights reserved.                    *
+ * Released under the BSD license - see LICENSE in the root for more details. *
+ ******************************************************************************
+ */
+
+#include "xenia/vfs/devices/gdox_nbd_disc_image_reader.h"
+
+#include <algorithm>
+#include <array>
+#include <charconv>
+#include <limits>
+
+#include "xenia/base/logging.h"
+
+namespace xe {
+namespace vfs {
+
+namespace {
+
+constexpr uint64_t kNbdInitMagic = UINT64_C(0x4e42444d41474943);
+constexpr uint64_t kNbdOptsMagic = UINT64_C(0x49484156454f5054);
+constexpr uint32_t kNbdRequestMagic = UINT32_C(0x25609513);
+constexpr uint32_t kNbdSimpleReplyMagic = UINT32_C(0x67446698);
+constexpr uint16_t kNbdFlagFixedNewstyle = UINT16_C(0x0001);
+constexpr uint16_t kNbdFlagNoZeroes = UINT16_C(0x0002);
+constexpr uint16_t kNbdFlagHasFlags = UINT16_C(0x0001);
+constexpr uint16_t kNbdFlagReadOnly = UINT16_C(0x0002);
+constexpr uint32_t kNbdClientFlagFixedNewstyle = UINT32_C(0x00000001);
+constexpr uint32_t kNbdClientFlagNoZeroes = UINT32_C(0x00000002);
+constexpr uint32_t kNbdOptionExportName = UINT32_C(1);
+constexpr uint16_t kNbdCommandRead = UINT16_C(0);
+constexpr uint16_t kNbdCommandDisconnect = UINT16_C(2);
+constexpr uint32_t kMaxReadBytes = 64U * 1024U;
+constexpr size_t kExportNameBytes = 32;
+
+uint16_t LoadBe16(const uint8_t* input) {
+  return uint16_t(uint16_t(input[0]) << 8 | uint16_t(input[1]));
+}
+
+uint32_t LoadBe32(const uint8_t* input) {
+  return uint32_t(input[0]) << 24 | uint32_t(input[1]) << 16 |
+         uint32_t(input[2]) << 8 | uint32_t(input[3]);
+}
+
+uint64_t LoadBe64(const uint8_t* input) {
+  return uint64_t(LoadBe32(input)) << 32 | LoadBe32(input + 4);
+}
+
+void StoreBe16(uint8_t* output, uint16_t value) {
+  output[0] = uint8_t(value >> 8);
+  output[1] = uint8_t(value);
+}
+
+void StoreBe32(uint8_t* output, uint32_t value) {
+  output[0] = uint8_t(value >> 24);
+  output[1] = uint8_t(value >> 16);
+  output[2] = uint8_t(value >> 8);
+  output[3] = uint8_t(value);
+}
+
+void StoreBe64(uint8_t* output, uint64_t value) {
+  StoreBe32(output, uint32_t(value >> 32));
+  StoreBe32(output + 4, uint32_t(value));
+}
+
+bool IsLowerHex(char value) {
+  return (value >= '0' && value <= '9') || (value >= 'a' && value <= 'f');
+}
+
+}  // namespace
+
+bool ParseGdoxNbdUri(std::string_view uri, GdoxNbdEndpoint* endpoint) {
+  constexpr std::string_view kPrefix = "nbd://127.0.0.1:";
+  if (!endpoint || uri.size() < kPrefix.size() ||
+      uri.substr(0, kPrefix.size()) != kPrefix) {
+    return false;
+  }
+  std::string_view remainder = uri.substr(kPrefix.size());
+  size_t slash = remainder.find('/');
+  if (slash == std::string_view::npos || slash == 0) {
+    return false;
+  }
+  std::string_view port_text = remainder.substr(0, slash);
+  std::string_view export_name = remainder.substr(slash + 1);
+  if (port_text.size() > 5 ||
+      (port_text.size() > 1 && port_text.front() == '0') ||
+      export_name.size() != kExportNameBytes ||
+      !std::all_of(export_name.begin(), export_name.end(), IsLowerHex)) {
+    return false;
+  }
+  uint32_t port = 0;
+  auto parsed = std::from_chars(port_text.data(),
+                                port_text.data() + port_text.size(), port, 10);
+  if (parsed.ec != std::errc() ||
+      parsed.ptr != port_text.data() + port_text.size() || port == 0 ||
+      port > std::numeric_limits<uint16_t>::max()) {
+    return false;
+  }
+  endpoint->port = uint16_t(port);
+  endpoint->export_name.assign(export_name);
+  return true;
+}
+
+GdoxNbdDiscImageReader::GdoxNbdDiscImageReader(
+    std::unique_ptr<GdoxNbdStream> stream)
+    : stream_(std::move(stream)) {}
+
+GdoxNbdDiscImageReader::~GdoxNbdDiscImageReader() {
+  std::lock_guard<std::mutex> lock(mutex_);
+  Disconnect();
+}
+
+std::unique_ptr<GdoxNbdDiscImageReader> GdoxNbdDiscImageReader::Open(
+    std::string_view uri) {
+  GdoxNbdEndpoint endpoint;
+  if (!ParseGdoxNbdUri(uri, &endpoint)) {
+    XELOGE("GDOX disc URI is invalid");
+    return nullptr;
+  }
+  auto stream = GdoxNbdStream::ConnectLoopback(endpoint.port);
+  if (!stream) {
+    XELOGE("Could not connect to the local GDOX disc session");
+    return nullptr;
+  }
+  return Open(std::move(stream), std::move(endpoint.export_name));
+}
+
+std::unique_ptr<GdoxNbdDiscImageReader> GdoxNbdDiscImageReader::Open(
+    std::unique_ptr<GdoxNbdStream> stream, std::string export_name) {
+  if (!stream || export_name.size() != kExportNameBytes ||
+      !std::all_of(export_name.begin(), export_name.end(), IsLowerHex)) {
+    return nullptr;
+  }
+  auto reader = std::unique_ptr<GdoxNbdDiscImageReader>(
+      new GdoxNbdDiscImageReader(std::move(stream)));
+  if (!reader->Negotiate(export_name)) {
+    return nullptr;
+  }
+  return reader;
+}
+
+bool GdoxNbdDiscImageReader::Negotiate(std::string_view export_name) {
+  std::array<uint8_t, 18> greeting = {};
+  if (!stream_->ReadExact(greeting.data(), greeting.size()) ||
+      LoadBe64(greeting.data()) != kNbdInitMagic ||
+      LoadBe64(greeting.data() + 8) != kNbdOptsMagic) {
+    Fail();
+    return false;
+  }
+  uint16_t server_flags = LoadBe16(greeting.data() + 16);
+  if ((server_flags & (kNbdFlagFixedNewstyle | kNbdFlagNoZeroes)) !=
+      (kNbdFlagFixedNewstyle | kNbdFlagNoZeroes)) {
+    Fail();
+    return false;
+  }
+
+  std::array<uint8_t, 4> client_flags = {};
+  StoreBe32(client_flags.data(),
+            kNbdClientFlagFixedNewstyle | kNbdClientFlagNoZeroes);
+  std::array<uint8_t, 16> option = {};
+  StoreBe64(option.data(), kNbdOptsMagic);
+  StoreBe32(option.data() + 8, kNbdOptionExportName);
+  StoreBe32(option.data() + 12, uint32_t(export_name.size()));
+  if (!stream_->WriteAll(client_flags.data(), client_flags.size()) ||
+      !stream_->WriteAll(option.data(), option.size()) ||
+      !stream_->WriteAll(export_name.data(), export_name.size())) {
+    Fail();
+    return false;
+  }
+
+  std::array<uint8_t, 10> export_info = {};
+  if (!stream_->ReadExact(export_info.data(), export_info.size())) {
+    Fail();
+    return false;
+  }
+  uint64_t export_size = LoadBe64(export_info.data());
+  uint16_t export_flags = LoadBe16(export_info.data() + 8);
+  if (export_size == 0 ||
+      export_size > uint64_t(std::numeric_limits<size_t>::max()) ||
+      (export_flags & (kNbdFlagHasFlags | kNbdFlagReadOnly)) !=
+          (kNbdFlagHasFlags | kNbdFlagReadOnly)) {
+    Fail();
+    return false;
+  }
+  size_.store(size_t(export_size), std::memory_order_release);
+  negotiated_ = true;
+  return true;
+}
+
+bool GdoxNbdDiscImageReader::Read(size_t offset, void* buffer, size_t length) {
+  std::lock_guard<std::mutex> lock(mutex_);
+  const size_t image_size = size_.load(std::memory_order_relaxed);
+  if (!negotiated_ || (length != 0 && buffer == nullptr) ||
+      offset > image_size || length > image_size - offset) {
+    return false;
+  }
+  auto output = static_cast<uint8_t*>(buffer);
+  size_t completed = 0;
+  while (completed < length) {
+    uint32_t chunk =
+        uint32_t(std::min(length - completed, size_t(kMaxReadBytes)));
+    if (!ReadChunk(uint64_t(offset) + completed, output + completed, chunk)) {
+      Fail();
+      return false;
+    }
+    completed += chunk;
+  }
+  return true;
+}
+
+bool GdoxNbdDiscImageReader::ReadChunk(uint64_t offset, uint8_t* output,
+                                       uint32_t length) {
+  uint64_t handle = next_handle_++;
+  std::array<uint8_t, 28> request = {};
+  StoreBe32(request.data(), kNbdRequestMagic);
+  StoreBe16(request.data() + 4, 0);
+  StoreBe16(request.data() + 6, kNbdCommandRead);
+  StoreBe64(request.data() + 8, handle);
+  StoreBe64(request.data() + 16, offset);
+  StoreBe32(request.data() + 24, length);
+  if (!stream_->WriteAll(request.data(), request.size())) {
+    return false;
+  }
+
+  std::array<uint8_t, 16> reply = {};
+  if (!stream_->ReadExact(reply.data(), reply.size()) ||
+      LoadBe32(reply.data()) != kNbdSimpleReplyMagic ||
+      LoadBe32(reply.data() + 4) != 0 || LoadBe64(reply.data() + 8) != handle) {
+    return false;
+  }
+  return length == 0 || stream_->ReadExact(output, length);
+}
+
+std::unique_ptr<MappedMemory> GdoxNbdDiscImageReader::Map(size_t offset,
+                                                          size_t length) {
+  (void)offset;
+  (void)length;
+  return nullptr;
+}
+
+void GdoxNbdDiscImageReader::Fail() {
+  negotiated_ = false;
+  size_.store(0, std::memory_order_release);
+  if (stream_) {
+    stream_->Close();
+  }
+}
+
+void GdoxNbdDiscImageReader::Disconnect() {
+  if (!stream_) {
+    return;
+  }
+  if (negotiated_) {
+    std::array<uint8_t, 28> request = {};
+    StoreBe32(request.data(), kNbdRequestMagic);
+    StoreBe16(request.data() + 4, 0);
+    StoreBe16(request.data() + 6, kNbdCommandDisconnect);
+    StoreBe64(request.data() + 8, next_handle_++);
+    stream_->WriteAll(request.data(), request.size());
+  }
+  stream_->Close();
+  negotiated_ = false;
+  size_.store(0, std::memory_order_release);
+}
+
+}  // namespace vfs
+}  // namespace xe
