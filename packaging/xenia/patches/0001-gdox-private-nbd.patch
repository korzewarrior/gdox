+X_STATUS Emulator::LaunchGdoxDisc(std::string_view uri) {
+  auto mount_path = "\\Device\\Cdrom0";
+
+  auto reader = vfs::DiscImageReader::OpenGdoxNbd(uri);
+  if (!reader) {
+    xe::FatalError("Unable to connect to the local GDOX disc session.");
+    return X_STATUS_NO_SUCH_FILE;
+  }
+  auto device =
+      std::make_unique<vfs::DiscImageDevice>(mount_path, std::move(reader));
+  if (!device->Initialize()) {
+    xe::FatalError("Unable to mount the GDOX disc session.");
+    return X_STATUS_NO_SUCH_FILE;
+  }
+  if (!file_system_->RegisterDevice(std::move(device))) {
+    xe::FatalError("Unable to register the GDOX disc session.");
+    return X_STATUS_NO_SUCH_FILE;
+  }
+
+  file_system_->RegisterSymbolicLink("game:", mount_path);
+  file_system_->RegisterSymbolicLink("d:", mount_path);
+
+  auto module_path(FindLaunchModule());
+  X_STATUS result = CompleteLaunch("GDOX live disc", module_path);
+
+  if (result == X_STATUS_NOT_FOUND && !cvars::launch_module.empty()) {
+    return LaunchDefaultModule("GDOX live disc");
+  }
+  kernel_state_->deployment_type_ = XDeploymentType::kOpticalDisc;
+  return result;
+}
