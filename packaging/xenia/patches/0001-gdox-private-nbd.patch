+ public:
+  static std::unique_ptr<GdoxNbdDiscImageReader> Open(std::string_view uri);
+
+  // Protocol-test seam. Production callers must use the URI overload.
+  static std::unique_ptr<GdoxNbdDiscImageReader> Open(
