+ */
+
+#include "xenia/vfs/devices/gdox_nbd_stream.h"
+
+#include <algorithm>
+#include <limits>
+#include <mutex>
+
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <winsock2.h>
+#include <ws2tcpip.h>
+
+namespace xe {
+namespace vfs {
+
+constexpr DWORD kGdoxNbdIoTimeoutMilliseconds = 30000;
+
+static bool InitializeGdoxWinsock() {
+  static std::once_flag initialized;
+  static bool success = false;
+  std::call_once(initialized, []() {
+    WSADATA data;
+    success = WSAStartup(MAKEWORD(2, 2), &data) == 0;
+  });
+  return success;
+}
+
+class WinGdoxNbdStream final : public GdoxNbdStream {
+ public:
+  explicit WinGdoxNbdStream(SOCKET socket) : socket_(socket) {}
+  ~WinGdoxNbdStream() override { Close(); }
+
+  bool ReadExact(void* buffer, size_t length) override {
+    auto output = static_cast<uint8_t*>(buffer);
+    size_t completed = 0;
+    while (completed < length) {
+      int request = int(std::min(length - completed,
+                                 size_t(std::numeric_limits<int>::max())));
+      int received = recv(socket_, reinterpret_cast<char*>(output + completed),
+                          request, 0);
+      if (received > 0) {
+        completed += size_t(received);
+      } else if (received == 0) {
+        Close();
+        return false;
+      } else if (WSAGetLastError() != WSAEINTR) {
+        Close();
+        return false;
+      }
+    }
+    return true;
+  }
+
+  bool WriteAll(const void* buffer, size_t length) override {
+    auto input = static_cast<const uint8_t*>(buffer);
+    size_t completed = 0;
+    while (completed < length) {
+      int request = int(std::min(length - completed,
+                                 size_t(std::numeric_limits<int>::max())));
+      int sent = send(socket_, reinterpret_cast<const char*>(input + completed),
+                      request, 0);
+      if (sent > 0) {
+        completed += size_t(sent);
+      } else if (sent == 0) {
+        Close();
+        return false;
+      } else if (WSAGetLastError() != WSAEINTR) {
+        Close();
+        return false;
+      }
+    }
+    return true;
+  }
+
+  void Close() override {
+    if (socket_ != INVALID_SOCKET) {
+      SOCKET socket = socket_;
+      socket_ = INVALID_SOCKET;
+      shutdown(socket, SD_BOTH);
+      closesocket(socket);
+    }
+  }
+
+ private:
+  SOCKET socket_ = INVALID_SOCKET;
+};
+
+std::unique_ptr<GdoxNbdStream> GdoxNbdStream::ConnectLoopback(uint16_t port) {
+  if (!InitializeGdoxWinsock()) {
+    return nullptr;
+  }
+  SOCKET socket_handle = socket(AF_INET, SOCK_STREAM, IPPROTO_TCP);
+  if (socket_handle == INVALID_SOCKET) {
+    return nullptr;
+  }
+  sockaddr_in address = {};
+  address.sin_family = AF_INET;
+  address.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+  address.sin_port = htons(port);
+  if (connect(socket_handle, reinterpret_cast<const sockaddr*>(&address),
+              sizeof(address)) == SOCKET_ERROR) {
+    closesocket(socket_handle);
+    return nullptr;
+  }
+  DWORD timeout = kGdoxNbdIoTimeoutMilliseconds;
+  if (setsockopt(socket_handle, SOL_SOCKET, SO_RCVTIMEO,
+                 reinterpret_cast<const char*>(&timeout),
+                 sizeof(timeout)) == SOCKET_ERROR ||
+      setsockopt(socket_handle, SOL_SOCKET, SO_SNDTIMEO,
+                 reinterpret_cast<const char*>(&timeout),
+                 sizeof(timeout)) == SOCKET_ERROR) {
+    closesocket(socket_handle);
+    return nullptr;
+  }
+  return std::make_unique<WinGdoxNbdStream>(socket_handle);
+}
