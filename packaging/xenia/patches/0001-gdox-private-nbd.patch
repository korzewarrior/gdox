+
+#include "xenia/vfs/devices/gdox_nbd_disc_image_reader.h"
+
+namespace xe {
+namespace vfs {
+
+class MappedDiscImageReader final : public DiscImageReader {
+ public:
+  explicit MappedDiscImageReader(std::unique_ptr<MappedMemory> mapping)
+      : mapping_(std::move(mapping)) {}
+
+  size_t size() const override { return mapping_->size(); }
+
+  bool Read(size_t offset, void* buffer, size_t length) override {
+    if (offset > size() || length > size() - offset ||
+        (length != 0 && buffer == nullptr)) {
+      return false;
+    }
+    if (length != 0) {
+      std::memcpy(buffer, mapping_->data() + offset, length);
+    }
+    return true;
+  }
+
+  bool can_map() const override { return true; }
+
+  std::unique_ptr<MappedMemory> Map(size_t offset, size_t length) override {
+    if (offset > size()) {
+      return nullptr;
+    }
+    size_t available = size() - offset;
+    size_t mapped_length = length ? std::min(length, available) : available;
+    return mapping_->Slice(offset, mapped_length);
+  }
+
+ private:
+  std::unique_ptr<MappedMemory> mapping_;
+};
+
+std::unique_ptr<DiscImageReader> DiscImageReader::OpenFile(
+    const std::filesystem::path& path) {
+  auto mapping = MappedMemory::Open(path, MappedMemory::Mode::kRead);
+  if (!mapping) {
+    return nullptr;
+  }
+  return std::make_unique<MappedDiscImageReader>(std::move(mapping));
+}
+
+std::unique_ptr<DiscImageReader> DiscImageReader::OpenGdoxNbd(
+    std::string_view uri) {
+  return GdoxNbdDiscImageReader::Open(uri);
+}
+
+}  // namespace vfs
+}  // namespace xe
