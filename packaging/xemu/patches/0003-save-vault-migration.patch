new file mode 100644
index 0000000..e319fb2
--- /dev/null
+++ b/include/block/xbox-save-vault.h
@@ -0,0 +1,114 @@
+/*
+ * Logical Original Xbox save vault
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef XBOX_SAVE_VAULT_H
+#define XBOX_SAVE_VAULT_H
+
+#include "qapi/error.h"
+
+#include <stdint.h>
+
+#include "block/xbox-save-policy.h"
+
+#define XBOX_SAVE_VAULT_CAPABILITY_SCHEMA 3U
+#define XBOX_SAVE_VAULT_ENVIRONMENT "GDOX_XEMU_SAVE_VAULT"
+#define XBOX_SAVE_VAULT_FORMAT "logical-files-v2"
+#define XBOX_SAVE_VAULT_TREE_DIGEST_BYTES 32U
+#define XBOX_SAVE_HDD_CONFIG_BYTES UINT64_C(0x80000)
+
+typedef int XboxSaveVaultRead(void *opaque, uint64_t offset,
+                              void *buffer, size_t bytes);
+typedef int XboxSaveVaultWrite(void *opaque, uint64_t offset,
+                               const void *buffer, size_t bytes);
+
+typedef struct XboxSaveVaultIo {
+    void *opaque;
+    XboxSaveVaultRead *read;
+    XboxSaveVaultWrite *write;
+    uint64_t disk_bytes;
+} XboxSaveVaultIo;
+
+typedef struct XboxSaveVaultLock {
+    int fd;
+} XboxSaveVaultLock;
+
+typedef struct XboxSaveVaultProof {
+    uint32_t vault_version;
+    uint64_t generation;
+    uint32_t entries;
+    uint64_t logical_bytes;
+    uint8_t tree_sha256[XBOX_SAVE_VAULT_TREE_DIGEST_BYTES];
+    uint32_t policy_revision;
+    uint8_t policy_sha256[XBOX_SAVE_POLICY_DIGEST_BYTES];
+    uint32_t udata_entries;
+    uint64_t udata_logical_bytes;
+    uint32_t tdata_entries;
+    uint64_t tdata_logical_bytes;
+    uint64_t hdd_config_bytes;
+    uint8_t hdd_config_sha256[XBOX_SAVE_VAULT_TREE_DIGEST_BYTES];
+    uint32_t unclassified_tdata_entries;
+    uint64_t unclassified_tdata_bytes;
+    uint8_t unclassified_tdata_sha256[XBOX_SAVE_VAULT_TREE_DIGEST_BYTES];
+    bool vault_reopened;
+    bool reprojected;
+    bool roundtrip_verified;
+} XboxSaveVaultProof;
+
+typedef bool XboxSaveVaultSourceVerify(void *opaque, Error **errp);
+
+#define XBOX_SAVE_VAULT_LOCK_INIT { .fd = -1 }
+
+/* One managed xemu process owns a vault at a time. */
+bool xbox_save_vault_lock(const char *directory, XboxSaveVaultLock *lock,
+                          Error **errp);
+void xbox_save_vault_unlock(XboxSaveVaultLock *lock);
+
+/*
+ * Imports the newest valid generation into the volatile HDD. A missing vault
+ * is an empty save set. The complete pack is validated before the first guest
+ * write.
+ */
+bool xbox_save_vault_import(const char *directory,
+                            const XboxSaveVaultIo *io, Error **errp);
+
+/*
+ * Atomically checkpoints logical E:\UDATA plus only reviewed, positive-policy
+ * E:\TDATA save/profile paths. Raw FAT entries, unused clusters, directory
+ * slack, unclassified TDATA, and every other partition are excluded.
+ */
+bool xbox_save_vault_checkpoint(const char *directory,
+                                const XboxSaveVaultIo *io, Error **errp);
+
+/* Validates the newest generation without opening or modifying an HDD. */
+bool xbox_save_vault_validate(const char *directory, Error **errp);
+bool xbox_save_vault_describe(const char *directory,
+                              XboxSaveVaultProof *proof, Error **errp);
+bool xbox_save_vault_try_describe(const char *directory,
+                                  XboxSaveVaultProof *proof, bool *found,
+                                  Error **errp);
+
+/*
+ * Stages a typed configuration/UDATA/reviewed-TDATA projection, reopens it,
+ * imports it into a clean anonymous HDD view, and compares a fresh projection
+ * before publication. Missing source entries are merged without replacing
+ * existing entries. source_projection_complete is false when a same-path
+ * source entry differs from the retained vault entry.
+ */
+bool xbox_save_vault_migrate(const char *directory,
+                             const XboxSaveVaultIo *source,
+                             const XboxSaveVaultIo *clean,
+                             XboxSaveVaultSourceVerify *verify_source,
+                             void *verify_opaque,
+                             XboxSaveVaultProof *proof,
+                             bool *source_projection_complete,
+                             Error **errp);
+
+bool xbox_save_vault_validate_roundtrip(const char *directory,
+                                        const XboxSaveVaultIo *clean,
+                                        XboxSaveVaultProof *proof,
+                                        Error **errp);
+
+#endif
