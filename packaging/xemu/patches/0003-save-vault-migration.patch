diff --git a/ui/xemu-gdox-save-operation.c b/ui/xemu-gdox-save-operation.c
new file mode 100644
index 0000000..2f07554
--- /dev/null
+++ b/ui/xemu-gdox-save-operation.c
@@ -0,0 +1,165 @@
+/*
+ * GDOX headless save maintenance
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+
+#include "block/block-global-state.h"
+#include "block/xbox-save-migration.h"
+#include "crypto/init.h"
+#include "qemu/main-loop.h"
+#include "system/system.h"
+#include "ui/xemu-gdox-save-operation.h"
+
+static char *xemu_gdox_digest_hex(const uint8_t digest[32])
+{
+    char *hex = g_malloc(65U);
+
+    for (unsigned int i = 0; i < 32U; i++) {
+        snprintf(hex + i * 2U, 3U, "%02x", digest[i]);
+    }
+    return hex;
+}
+
+bool xemu_gdox_save_operation_run(const XemuGdoxLaunch *launch,
+                                  char **result, Error **errp)
+{
+    XboxSaveVaultProof vault;
+    g_autofree char *tree_sha = NULL;
+
+    *result = NULL;
+    if (qcrypto_init(errp) < 0) {
+        return false;
+    }
+    qemu_init_subsystems();
+    if (qemu_init_main_loop(errp) < 0) {
+        return false;
+    }
+    if (launch->mode == XEMU_GDOX_LAUNCH_MIGRATE ||
+        launch->mode == XEMU_GDOX_LAUNCH_MIGRATE_REMOVE) {
+        XboxSaveMigrationProof proof;
+        const char *operation = launch->mode == XEMU_GDOX_LAUNCH_MIGRATE_REMOVE
+            ? "xbox-hdd-save-migration-removal"
+            : "xbox-hdd-save-migration";
+        g_autofree char *source_identity = NULL;
+        g_autofree char *source_sha = NULL;
+        g_autofree char *clean_sha = NULL;
+        g_autofree char *policy_sha = NULL;
+        g_autofree char *config_sha = NULL;
+        g_autofree char *unclassified_sha = NULL;
+
+        if (launch->mode == XEMU_GDOX_LAUNCH_MIGRATE_REMOVE
+                ? !xbox_save_migration_execute_and_remove(
+                      &launch->migration, &proof, errp)
+                : !xbox_save_migration_execute(
+                      &launch->migration, &proof, errp)) {
+            return false;
+        }
+        source_identity = xemu_gdox_digest_hex(
+            proof.source_identity_sha256);
+        source_sha = xemu_gdox_digest_hex(proof.source_sha256);
+        clean_sha = xemu_gdox_digest_hex(proof.clean_sha256);
+        tree_sha = xemu_gdox_digest_hex(proof.vault.tree_sha256);
+        policy_sha = xemu_gdox_digest_hex(proof.vault.policy_sha256);
+        config_sha = xemu_gdox_digest_hex(proof.vault.hdd_config_sha256);
+        unclassified_sha = xemu_gdox_digest_hex(
+            proof.vault.unclassified_tdata_sha256);
+        *result = g_strdup_printf(
+            "{\"schema\":3,\"operation\":\"%s\","
+            "\"source_writes\":%s,\"source_bytes\":%" PRIu64 ","
+            "\"source_identity_sha256\":\"%s\","
+            "\"source_sha256\":\"%s\",\"source_hashed\":%s,"
+            "\"source_projection_complete\":%s,"
+            "\"clean_bytes\":%" PRIu64 ",\"clean_sha256\":\"%s\","
+            "\"receipt_reused\":%s,\"source_removal_safe\":%s,"
+            "\"source_removed\":%s,"
+            "\"vault_version\":%u,\"generation\":%" PRIu64 ","
+            "\"scope\":\"hdd-config-v1+E:\\\\UDATA+reviewed-E:\\\\TDATA\","
+            "\"format\":\"logical-files-v2\",\"entries\":%u,"
+            "\"logical_bytes\":%" PRIu64 ",\"tree_sha256\":\"%s\","
+            "\"policy_revision\":%u,\"policy_sha256\":\"%s\","
+            "\"udata_entries\":%u,\"udata_logical_bytes\":%" PRIu64 ","
+            "\"tdata_entries\":%u,\"tdata_logical_bytes\":%" PRIu64 ","
+            "\"hdd_config_format\":\"hdd-config-v1\","
+            "\"hdd_config_bytes\":%" PRIu64 ","
+            "\"hdd_config_sha256\":\"%s\","
+            "\"unclassified_tdata_entries\":%u,"
+            "\"unclassified_tdata_bytes\":%" PRIu64 ","
+            "\"unclassified_tdata_sha256\":\"%s\","
+            "\"vault_reopened\":%s,\"anonymous_cow\":%s,"
+            "\"clean_backing\":%s,\"reprojected\":%s,"
+            "\"roundtrip_verified\":%s}\n",
+            operation, proof.source_writes ? "true" : "false",
+            proof.source_bytes, source_identity, source_sha,
+            proof.source_hashed ? "true" : "false",
+            proof.source_projection_complete ? "true" : "false",
+            proof.clean_bytes, clean_sha,
+            proof.receipt_reused ? "true" : "false",
+            proof.source_removal_safe ? "true" : "false",
+            proof.source_removed ? "true" : "false",
+            proof.vault.vault_version, proof.vault.generation,
+            proof.vault.entries, proof.vault.logical_bytes, tree_sha,
+            proof.vault.policy_revision, policy_sha,
+            proof.vault.udata_entries, proof.vault.udata_logical_bytes,
+            proof.vault.tdata_entries, proof.vault.tdata_logical_bytes,
+            proof.vault.hdd_config_bytes, config_sha,
+            proof.vault.unclassified_tdata_entries,
+            proof.vault.unclassified_tdata_bytes, unclassified_sha,
+            proof.vault.vault_reopened ? "true" : "false",
+            proof.anonymous_cow ? "true" : "false",
+            proof.clean_backing ? "true" : "false",
+            proof.vault.reprojected ? "true" : "false",
+            proof.vault.roundtrip_verified ? "true" : "false");
+        return true;
+    }
+    if (launch->mode == XEMU_GDOX_LAUNCH_VALIDATE) {
+        g_autofree char *policy_sha = NULL;
+        g_autofree char *config_sha = NULL;
+        g_autofree char *unclassified_sha = NULL;
+        if (!xbox_save_vault_validation_execute(
+                launch->validation_vault, launch->validation_clean_hdd,
+                &vault, errp)) {
+            return false;
+        }
+        tree_sha = xemu_gdox_digest_hex(vault.tree_sha256);
+        policy_sha = xemu_gdox_digest_hex(vault.policy_sha256);
+        config_sha = xemu_gdox_digest_hex(vault.hdd_config_sha256);
+        unclassified_sha = xemu_gdox_digest_hex(
+            vault.unclassified_tdata_sha256);
+        *result = g_strdup_printf(
+            "{\"schema\":3,\"operation\":\"xbox-save-vault-validation\","
+            "\"vault_version\":%u,\"generation\":%" PRIu64 ","
+            "\"scope\":\"hdd-config-v1+E:\\\\UDATA+reviewed-E:\\\\TDATA\","
+            "\"format\":\"logical-files-v2\","
+            "\"entries\":%u,\"logical_bytes\":%" PRIu64 ","
+            "\"tree_sha256\":\"%s\","
+            "\"policy_revision\":%u,\"policy_sha256\":\"%s\","
+            "\"udata_entries\":%u,\"udata_logical_bytes\":%" PRIu64 ","
+            "\"tdata_entries\":%u,\"tdata_logical_bytes\":%" PRIu64 ","
+            "\"hdd_config_format\":\"hdd-config-v1\","
+            "\"hdd_config_bytes\":%" PRIu64 ","
+            "\"hdd_config_sha256\":\"%s\","
+            "\"unclassified_tdata_entries\":%u,"
+            "\"unclassified_tdata_bytes\":%" PRIu64 ","
+            "\"unclassified_tdata_sha256\":\"%s\","
+            "\"vault_reopened\":%s,"
+            "\"anonymous_cow\":true,\"clean_backing\":true,"
+            "\"reprojected\":%s,\"roundtrip_verified\":%s}\n",
+            vault.vault_version, vault.generation,
+            vault.entries, vault.logical_bytes, tree_sha,
+            vault.policy_revision, policy_sha,
+            vault.udata_entries, vault.udata_logical_bytes,
+            vault.tdata_entries, vault.tdata_logical_bytes,
+            vault.hdd_config_bytes, config_sha,
+            vault.unclassified_tdata_entries,
+            vault.unclassified_tdata_bytes, unclassified_sha,
+            vault.vault_reopened ? "true" : "false",
+            vault.reprojected ? "true" : "false",
+            vault.roundtrip_verified ? "true" : "false");
+        return true;
+    }
+    error_setg(errp, "GDOX save operation mode is invalid");
+    return false;
+}
