+/*
+ * Volatile Original Xbox hard disk
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef XBOX_VOLATILE_HDD_H
+#define XBOX_VOLATILE_HDD_H
+
+#include "qapi/error.h"
+#include "qemu/typedefs.h"
+#include "qemu/units.h"
+
+#define XBOX_VOLATILE_HDD_CACHE_START UINT64_C(0x00080000)
+#define XBOX_VOLATILE_HDD_CACHE_END   UINT64_C(0x8ca80000)
+#define XBOX_VOLATILE_HDD_E_START     UINT64_C(0xabe80000)
+#define XBOX_VOLATILE_HDD_E_END       UINT64_C(0x1dd156000)
+#define XBOX_VOLATILE_HDD_PAGE_SIZE (64 * KiB)
+#define XBOX_VOLATILE_HDD_MAX_PAGE_LIMIT 65536
+#define XBOX_VOLATILE_HDD_MAX_DIRTY_BYTES \
+    (UINT64_C(65536) * \
+     XBOX_VOLATILE_HDD_PAGE_SIZE)
+#define XBOX_VOLATILE_HDD_UNKNOWN_HOST_DIRTY_BYTES GiB
+
+bool xbox_volatile_hdd_attach(BlockBackend *blk, Error **errp);
+
+/* Migration uses a clean anonymous overlay without importing the live vault. */
+bool xbox_volatile_hdd_attach_clean(BlockBackend *blk, Error **errp);
+
+/* Unit tests use a smaller limit to exercise allocation failure handling. */
+bool xbox_volatile_hdd_attach_with_page_limit(BlockBackend *blk,
+                                               uint32_t page_limit,
+                                               Error **errp);
+
+/* Set only while the latest save checkpoint is not durably verified. */
+bool xbox_volatile_hdd_save_failed(void);
+int xbox_volatile_hdd_adjust_exit_status(int status);
+
+#endif
