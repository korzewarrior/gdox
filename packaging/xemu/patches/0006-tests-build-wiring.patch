+                            stored.policy_sha256);
+    stored.vault_generation = 7U;
+    memset(stored.vault_tree_sha256, 0x44,
+           sizeof(stored.vault_tree_sha256));
+    stored.vault_entries = 12U;
+    stored.vault_logical_bytes = 8192U;
+    stored.unclassified_tdata_entries = 1U;
+    stored.unclassified_tdata_bytes = 17U;
+    memset(stored.unclassified_tdata_sha256, 0x55,
+           sizeof(stored.unclassified_tdata_sha256));
