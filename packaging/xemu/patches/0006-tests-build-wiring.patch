diff --git a/tests/unit/xemu-gdox-test-security.h b/tests/unit/xemu-gdox-test-security.h
new file mode 100644
index 0000000..0ad7d70
--- /dev/null
+++ b/tests/unit/xemu-gdox-test-security.h
@@ -0,0 +1,81 @@
+/*
+ * Private temporary storage for GDOX xemu tests
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef XEMU_GDOX_TEST_SECURITY_H
+#define XEMU_GDOX_TEST_SECURITY_H
+
+#include <glib/gstdio.h>
+
+#ifdef _WIN32
+#include <aclapi.h>
+#endif
+
+static char *gdox_test_private_directory_new(const char *template_name)
+{
+    GError *error = NULL;
+
+#ifdef _WIN32
+    g_autofree void *user_buffer = NULL;
+    g_autofree ACL *acl = NULL;
+    g_autofree gunichar2 *wide = NULL;
+    HANDLE token = NULL;
+    TOKEN_USER *user;
+    TOKEN_OWNER default_owner;
+    DWORD user_bytes = 0U;
+    DWORD acl_bytes;
+    DWORD status;
+
+    g_assert_true(OpenProcessToken(
+        GetCurrentProcess(), TOKEN_QUERY | TOKEN_ADJUST_DEFAULT, &token));
+    g_assert_false(GetTokenInformation(
+        token, TokenUser, NULL, 0U, &user_bytes));
+    g_assert_cmpuint(GetLastError(), ==, ERROR_INSUFFICIENT_BUFFER);
+    g_assert_cmpuint(user_bytes, >, 0U);
+    user_buffer = g_malloc(user_bytes);
+    g_assert_true(GetTokenInformation(
+        token, TokenUser, user_buffer, user_bytes, &user_bytes));
+    user = user_buffer;
+    default_owner = (TOKEN_OWNER){ .Owner = user->User.Sid };
+    g_assert_true(SetTokenInformation(
+        token, TokenOwner, &default_owner, sizeof(default_owner)));
+#endif
+
+    char *directory = g_dir_make_tmp(template_name, &error);
+
+    g_assert_no_error(error);
+    g_assert_nonnull(directory);
+
+#ifdef _WIN32
+    acl_bytes = (DWORD)sizeof(*acl) + (DWORD)sizeof(ACCESS_ALLOWED_ACE) -
+                (DWORD)sizeof(DWORD) + GetLengthSid(user->User.Sid);
+    acl = g_malloc(acl_bytes);
+    g_assert_true(InitializeAcl(acl, acl_bytes, ACL_REVISION));
+    g_assert_true(AddAccessAllowedAceEx(
+        acl,
+        ACL_REVISION,
+        OBJECT_INHERIT_ACE | CONTAINER_INHERIT_ACE,
+        FILE_ALL_ACCESS,
+        user->User.Sid));
+    wide = g_utf8_to_utf16(directory, -1, NULL, NULL, NULL);
+    g_assert_nonnull(wide);
+    status = SetNamedSecurityInfoW(
+        (LPWSTR)wide,
+        SE_FILE_OBJECT,
+        OWNER_SECURITY_INFORMATION | DACL_SECURITY_INFORMATION |
+            PROTECTED_DACL_SECURITY_INFORMATION,
+        user->User.Sid,
+        NULL,
+        acl,
+        NULL);
+    g_assert_cmpuint(status, ==, ERROR_SUCCESS);
+    g_assert_true(CloseHandle(token));
+#else
+    g_assert_cmpint(g_chmod(directory, 0700), ==, 0);
+#endif
+    return directory;
+}
+
+#endif
diff --git a/tests/unit/test-xbox-save-vault.c b/tests/unit/test-xbox-save-vault.c
new file mode 100644
index 0000000..b7f460c
--- /dev/null
+++ b/tests/unit/test-xbox-save-vault.c
@@ -0,0 +1,1479 @@
+/*
+ * Logical Original Xbox save vault tests
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+
+#include "block/xbox-save-vault.h"
+#include "block/xbox-save-migration.h"
+#include "block/xbox-save-receipt.h"
+#include "block/block-global-state.h"
+#include "block/xbox-volatile-hdd.h"
+#include "qapi/error.h"
+#include "qemu/bswap.h"
+#include "qemu/cutils.h"
+#include "qemu/units.h"
+#include "qemu/main-loop.h"
+#include "tests/unit/xemu-gdox-test-security.h"
+
+#include <glib/gstdio.h>
+
+#ifndef _WIN32
+#include <sys/resource.h>
+#include <sys/wait.h>
+#endif
+
+#define TEST_PAGE_BYTES 4096U
+#define TEST_E_BYTES UINT64_C(0x1312d6000)
+#define TEST_CLUSTER_BYTES (16U * KiB)
+#define TEST_HEADER_BYTES 40U
+#define TEST_HEADER_V2_BYTES 76U
+#define TEST_ENTRY_BYTES 20U
+#define TEST_DIGEST_BYTES 32U
+
+typedef struct TestDisk {
+    GHashTable *pages;
+    unsigned int reads;
+} TestDisk;
+
+typedef struct TestArchiveEntry {
+    uint8_t type;
+    uint8_t attributes;
+    const char *path;
+    const uint8_t *data;
+    uint32_t bytes;
+} TestArchiveEntry;
+
+static TestDisk *test_disk_new(void)
+{
+    TestDisk *disk = g_new0(TestDisk, 1);
+
+    disk->pages = g_hash_table_new_full(g_int64_hash, g_int64_equal,
+                                        g_free, g_free);
+    return disk;
+}
+
+static void test_disk_free(TestDisk *disk)
+{
+    g_hash_table_unref(disk->pages);
+    g_free(disk);
+}
+
+G_DEFINE_AUTOPTR_CLEANUP_FUNC(TestDisk, test_disk_free)
+
+static uint8_t *test_disk_page(TestDisk *disk, uint64_t index, bool create)
+{
+    uint8_t *page = g_hash_table_lookup(disk->pages, &index);
+
+    if (!page && create) {
+        uint64_t *key = g_new(uint64_t, 1);
+
+        *key = index;
+        page = g_malloc0(TEST_PAGE_BYTES);
+        g_hash_table_insert(disk->pages, key, page);
+    }
+    return page;
+}
+
+static int test_disk_read(void *opaque, uint64_t offset,
+                          void *buffer, size_t bytes)
+{
+    TestDisk *disk = opaque;
+    uint8_t *destination = buffer;
+
+    disk->reads++;
+    while (bytes > 0) {
+        uint64_t page_index = offset / TEST_PAGE_BYTES;
+        size_t page_offset = offset % TEST_PAGE_BYTES;
+        size_t chunk = MIN(bytes, TEST_PAGE_BYTES - page_offset);
+        uint8_t *page = test_disk_page(disk, page_index, false);
+
+        if (page) {
+            memcpy(destination, page + page_offset, chunk);
+        } else {
+            memset(destination, 0, chunk);
+        }
+        offset += chunk;
+        destination += chunk;
+        bytes -= chunk;
+    }
+    return 0;
+}
+
+static int test_disk_write(void *opaque, uint64_t offset,
+                           const void *buffer, size_t bytes)
+{
+    TestDisk *disk = opaque;
+    const uint8_t *source = buffer;
+
+    while (bytes > 0) {
+        uint64_t page_index = offset / TEST_PAGE_BYTES;
+        size_t page_offset = offset % TEST_PAGE_BYTES;
+        size_t chunk = MIN(bytes, TEST_PAGE_BYTES - page_offset);
+        uint8_t *page = test_disk_page(disk, page_index, true);
+
+        memcpy(page + page_offset, source, chunk);
+        offset += chunk;
+        source += chunk;
+        bytes -= chunk;
+    }
+    return 0;
+}
+
+static uint64_t test_cluster_offset(void)
+{
+    uint64_t nominal_clusters = TEST_E_BYTES / TEST_CLUSTER_BYTES + 1U;
+    uint64_t fat_bytes = ROUND_UP(nominal_clusters * 4U, TEST_PAGE_BYTES);
+
+    return XBOX_VOLATILE_HDD_E_START + TEST_PAGE_BYTES + fat_bytes;
+}
+
+static void test_set_fat(TestDisk *disk, uint32_t cluster, uint32_t value)
+{
+    uint8_t raw[4];
+
+    stl_le_p(raw, value);
+    test_disk_write(disk, XBOX_VOLATILE_HDD_E_START + TEST_PAGE_BYTES +
+                          (uint64_t)cluster * 4U, raw, sizeof(raw));
+}
+
+static void test_put_dirent(uint8_t *cluster, unsigned int index,
+                            const char *name, uint8_t attributes,
+                            uint32_t first_cluster, uint32_t file_bytes)
+{
+    uint8_t *entry = cluster + index * 64U;
+    size_t name_bytes = strlen(name);
+
+    memset(entry, 0xff, 64U);
+    entry[0] = name_bytes;
+    entry[1] = attributes;
+    memcpy(entry + 2U, name, name_bytes);
+    stl_le_p(entry + 44U, first_cluster);
+    stl_le_p(entry + 48U, file_bytes);
+}
+
+static TestDisk *test_disk_seed(void)
+{
+    TestDisk *disk = test_disk_new();
+    uint8_t superblock[TEST_PAGE_BYTES] = { 0 };
+    g_autofree uint8_t *root = g_malloc(TEST_CLUSTER_BYTES);
+    g_autofree uint8_t *tdata = g_malloc(TEST_CLUSTER_BYTES);
+    static const uint8_t cache_data[] = "excluded title cache";
+    uint64_t clusters = test_cluster_offset();
+
+    for (uint64_t offset = 0U; offset < XBOX_SAVE_HDD_CONFIG_BYTES;
+         offset += TEST_PAGE_BYTES) {
+        uint8_t config[TEST_PAGE_BYTES];
+
+        for (size_t i = 0; i < sizeof(config); i++) {
+            config[i] = (uint8_t)((offset + i) * 29U + 7U);
+        }
+        test_disk_write(disk, offset, config, sizeof(config));
+    }
+
+    memcpy(superblock, "FATX", 4U);
+    stl_le_p(superblock + 8U, 32U);
+    stl_le_p(superblock + 12U, 1U);
+    test_disk_write(disk, XBOX_VOLATILE_HDD_E_START,
+                    superblock, sizeof(superblock));
+    test_set_fat(disk, 0U, UINT32_C(0xfffffff8));
+    test_set_fat(disk, 1U, UINT32_MAX);
+    test_set_fat(disk, 10U, UINT32_MAX);
+    test_set_fat(disk, 11U, UINT32_MAX);
+
+    memset(root, 0xff, TEST_CLUSTER_BYTES);
+    test_put_dirent(root, 0U, "TDATA", 0x10U, 10U, 0U);
+    test_disk_write(disk, clusters, root, TEST_CLUSTER_BYTES);
+
+    memset(tdata, 0xff, TEST_CLUSTER_BYTES);
+    test_put_dirent(tdata, 0U, "CACHE.BIN", 0x00U, 11U,
+                    sizeof(cache_data));
+    test_disk_write(disk, clusters + 9U * TEST_CLUSTER_BYTES,
+                    tdata, TEST_CLUSTER_BYTES);
+    test_disk_write(disk, clusters + 10U * TEST_CLUSTER_BYTES,
+                    cache_data, sizeof(cache_data));
+    return disk;
+}
+
+static void test_disk_set_tdata_inventory(TestDisk *disk, bool zero_file)
+{
+    g_autofree uint8_t *tdata = g_malloc(TEST_CLUSTER_BYTES);
+    uint64_t offset = test_cluster_offset() + 9U * TEST_CLUSTER_BYTES;
+
+    memset(tdata, 0xff, TEST_CLUSTER_BYTES);
+    if (zero_file) {
+        test_put_dirent(tdata, 0U, "ZERO.BIN", 0x00U, 0U, 0U);
+    }
+    test_disk_write(disk, offset, tdata, TEST_CLUSTER_BYTES);
+}
+
+static char *test_directory_new(void)
+{
+    return gdox_test_private_directory_new("xemu-save-vault-XXXXXX");
+}
+
+static char *test_slot_path(const char *directory, unsigned int slot)
+{
+    return g_strdup_printf("%s%coriginal-xbox-udata-%u.gdox",
+                           directory, G_DIR_SEPARATOR, slot);
+}
+
+static char *test_receipt_path(const char *directory)
+{
+    return g_build_filename(directory,
+                            "original-xbox-migration-receipt-v1.gdox",
+                            NULL);
+}
+
+static void test_directory_free(char *directory)
+{
+    g_autoptr(GDir) listing = g_dir_open(directory, 0, NULL);
+    const char *name;
+
+    while (listing && (name = g_dir_read_name(listing))) {
+        g_autofree char *path = g_build_filename(directory, name, NULL);
+
+        g_assert_cmpint(g_unlink(path), ==, 0);
+    }
+    g_clear_pointer(&listing, g_dir_close);
+    g_assert_cmpint(g_rmdir(directory), ==, 0);
+    g_free(directory);
+}
+
+static void test_append_u16(GByteArray *bytes, uint16_t value)
+{
+    uint8_t raw[2];
+
+    stw_le_p(raw, value);
+    g_byte_array_append(bytes, raw, sizeof(raw));
+}
+
+static void test_append_u32(GByteArray *bytes, uint32_t value)
+{
+    uint8_t raw[4];
+
+    stl_le_p(raw, value);
+    g_byte_array_append(bytes, raw, sizeof(raw));
+}
+
+static void test_append_u64(GByteArray *bytes, uint64_t value)
+{
+    uint8_t raw[8];
+
+    stq_le_p(raw, value);
+    g_byte_array_append(bytes, raw, sizeof(raw));
+}
+
+static GByteArray *test_archive_build(uint64_t generation,
+                                      const TestArchiveEntry *entries,
+                                      size_t count)
+{
+    g_autoptr(GChecksum) checksum = g_checksum_new(G_CHECKSUM_SHA256);
+    GByteArray *bytes = g_byte_array_new();
+    uint8_t digest[TEST_DIGEST_BYTES];
+    uint64_t logical_bytes = 0U;
+    gsize digest_bytes = sizeof(digest);
+
+    for (size_t i = 0; i < count; i++) {
+        logical_bytes += entries[i].type == 2U ? entries[i].bytes : 0U;
+    }
+    g_byte_array_append(bytes, (const uint8_t *)"GDOXSAV1", 8U);
+    test_append_u32(bytes, 1U);
+    test_append_u32(bytes, TEST_HEADER_BYTES);
+    test_append_u64(bytes, generation);
+    test_append_u32(bytes, count);
+    test_append_u32(bytes, 0U);
+    test_append_u64(bytes, logical_bytes);
+    for (size_t i = 0; i < count; i++) {
+        const TestArchiveEntry *entry = &entries[i];
+        size_t path_bytes = strlen(entry->path);
+
+        g_byte_array_append(bytes,
+                            (const uint8_t[]){ entry->type,
+                                               entry->attributes }, 2U);
+        test_append_u16(bytes, path_bytes);
+        test_append_u32(bytes, entry->bytes);
+        g_byte_array_append(bytes, (const uint8_t[12]){ 0 }, 12U);
+        g_byte_array_append(bytes, (const uint8_t *)entry->path, path_bytes);
+        if (entry->type == 2U && entry->bytes) {
+            g_byte_array_append(bytes, entry->data, entry->bytes);
+        }
+    }
+    g_checksum_update(checksum, bytes->data, bytes->len);
+    g_checksum_get_digest(checksum, digest, &digest_bytes);
+    g_assert_cmpuint(digest_bytes, ==, sizeof(digest));
+    g_byte_array_append(bytes, digest, sizeof(digest));
+    return bytes;
+}
+
+static void test_archive_write(const char *directory, unsigned int slot,
+                               const GByteArray *bytes)
+{
+    g_autofree char *path = test_slot_path(directory, slot);
+    int fd = g_open(path, O_WRONLY | O_CREAT | O_EXCL | O_BINARY, 0600);
+
+    g_assert_cmpint(fd, >=, 0);
+    g_assert_cmpint(qemu_write_full(fd, bytes->data, bytes->len),
+                    ==, bytes->len);
+    g_assert_cmpint(qemu_close(fd), ==, 0);
+}
+
+static GByteArray *test_archive_sample(uint64_t generation)
+{
+    static uint8_t large_file[TEST_CLUSTER_BYTES + 211U];
+    static const uint8_t nickname[] = "Preservation";
+    static bool initialized;
+    TestArchiveEntry entries[] = {
+        { 1U, 0x10U, "4d530064", NULL, 0U },
+        { 2U, 0x04U, "4d530064/SaveMeta.xbx", large_file,
+          sizeof(large_file) },
+        { 1U, 0x10U, "4d5307e6", NULL, 0U },
+        { 2U, 0x00U, "4d5307e6/empty.bin", NULL, 0U },
+        { 2U, 0x00U, "NICKNAME.XBN", nickname, sizeof(nickname) },
+    };
+
+    if (!initialized) {
+        for (size_t i = 0; i < sizeof(large_file); i++) {
+            large_file[i] = (uint8_t)(i * 37U + 11U);
+        }
+        initialized = true;
+    }
+    return test_archive_build(generation, entries, ARRAY_SIZE(entries));
+}
+
+static XboxSaveVaultIo test_io(TestDisk *disk)
+{
+    return (XboxSaveVaultIo) {
+        .opaque = disk,
+        .read = test_disk_read,
+        .write = test_disk_write,
+        .disk_bytes = XBOX_VOLATILE_HDD_E_END,
+    };
+}
+
+static bool test_verify_source(void *opaque, Error **errp)
+{
+    unsigned int *calls = opaque;
+
+    (*calls)++;
+    return true;
+}
+
+static bool test_reject_source(void *opaque, Error **errp)
+{
+    unsigned int *calls = opaque;
+
+    (*calls)++;
+    error_setg(errp, "Legacy source changed");
+    return false;
+}
+
+static bool test_verify_complete_proof(void *opaque, Error **errp)
+{
+    const XboxSaveVaultProof *proof = opaque;
+
+    if (!proof->vault_reopened || !proof->reprojected ||
+        !proof->roundtrip_verified) {
+        error_setg(errp, "Migration proof was incomplete before verification");
+        return false;
+    }
+    return true;
+}
+
+typedef struct TestPublishRace {
+    const char *directory;
+    const GByteArray *archive;
+} TestPublishRace;
+
+static bool test_create_publication_target(void *opaque, Error **errp)
+{
+    TestPublishRace *race = opaque;
+
+    test_archive_write(race->directory, 0U, race->archive);
+    return true;
+}
+
+typedef struct TestCorruptWrite {
+    TestDisk *disk;
+} TestCorruptWrite;
+
+static int test_corrupt_payload_write(void *opaque, uint64_t offset,
+                                      const void *buffer, size_t bytes)
+{
+    TestCorruptWrite *corrupt = opaque;
+
+    if (bytes == TEST_CLUSTER_BYTES && !buffer_is_zero(buffer, bytes)) {
+        g_autofree uint8_t *changed = g_memdup2(buffer, bytes);
+
+        changed[0] ^= 0x80U;
+        return test_disk_write(corrupt->disk, offset, changed, bytes);
+    }
+    return test_disk_write(corrupt->disk, offset, buffer, bytes);
+}
+
+static int test_corrupt_read(void *opaque, uint64_t offset,
+                             void *buffer, size_t bytes)
+{
+    TestCorruptWrite *corrupt = opaque;
+
+    return test_disk_read(corrupt->disk, offset, buffer, bytes);
+}
+
+typedef struct TestReadFailure {
+    TestDisk *disk;
+    bool fail;
+} TestReadFailure;
+
+static int test_failing_read(void *opaque, uint64_t offset,
+                             void *buffer, size_t bytes)
+{
+    TestReadFailure *failure = opaque;
+
+    if (failure->fail && offset < XBOX_SAVE_HDD_CONFIG_BYTES) {
+        return -EIO;
+    }
+    return test_disk_read(failure->disk, offset, buffer, bytes);
+}
+
+static void test_roundtrip_and_scope(void)
+{
+    g_autofree char *source = test_directory_new();
+    g_autofree char *destination = test_directory_new();
+    g_autofree char *destination_slot = test_slot_path(destination, 0U);
+    g_autoptr(GByteArray) archive = test_archive_sample(1U);
+    g_autofree gchar *destination_bytes = NULL;
+    g_autofree gchar *roundtrip_bytes = NULL;
+    gsize destination_size;
+    gsize roundtrip_size;
+    g_autoptr(TestDisk) disk = test_disk_seed();
+    g_autoptr(TestDisk) restored = test_disk_seed();
+    g_autoptr(TestDisk) validation_clean = test_disk_seed();
+    XboxSaveVaultIo io = test_io(disk);
+    XboxSaveVaultIo restored_io = test_io(restored);
+    XboxSaveVaultIo validation_io = test_io(validation_clean);
+    XboxSaveVaultProof proof;
+    g_autofree char *roundtrip = test_directory_new();
+    g_autofree char *roundtrip_slot = test_slot_path(roundtrip, 0U);
+
+    test_archive_write(source, 0U, archive);
+    g_assert_true(xbox_save_vault_validate_roundtrip(
+        source, &validation_io, &proof, &error_abort));
