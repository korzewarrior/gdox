+static void test_same_size_mutation_changes_source_identity(void)
+{
+    g_autofree char *directory = test_directory_new();
+    g_autofree char *path = g_build_filename(directory, "source.bin", NULL);
+    XboxSaveMigrationSourceSnapshot before =
+        XBOX_SAVE_MIGRATION_SOURCE_SNAPSHOT_INIT;
+    XboxSaveMigrationSourceSnapshot after =
+        XBOX_SAVE_MIGRATION_SOURCE_SNAPSHOT_INIT;
+    uint8_t before_identity[32];
+    uint8_t contents[4096];
+    int fd;
+
+    memset(contents, 0x5a, sizeof(contents));
+    fd = g_open(path, O_WRONLY | O_CREAT | O_EXCL | O_BINARY, 0600);
+    g_assert_cmpint(fd, >=, 0);
+    g_assert_cmpint(qemu_write_full(fd, contents, sizeof(contents)),
+                    ==, sizeof(contents));
+    g_assert_cmpint(qemu_close(fd), ==, 0);
+    g_assert_true(xbox_save_migration_source_snapshot_open(
+        path, &before, &error_abort));
+    memcpy(before_identity, before.identity_sha256,
+           sizeof(before_identity));
+    xbox_save_migration_source_snapshot_close(&before);
+
+    fd = g_open(path, O_RDWR | O_BINARY, 0600);
+    g_assert_cmpint(fd, >=, 0);
+    contents[0] ^= 0xffU;
+    g_assert_cmpint(lseek(fd, 0U, SEEK_SET), ==, 0);
+    g_assert_cmpint(qemu_write_full(fd, contents, 1U), ==, 1);
+    g_assert_cmpint(qemu_close(fd), ==, 0);
+    g_assert_true(xbox_save_migration_source_snapshot_open(
+        path, &after, &error_abort));
+    g_assert_cmpint(memcmp(before_identity, after.identity_sha256,
+                           sizeof(before_identity)), !=, 0);
+    xbox_save_migration_source_snapshot_close(&after);
+
+    g_assert_cmpint(g_unlink(path), ==, 0);
+    test_directory_free(g_steal_pointer(&directory));
+}
