index 0000000..c8a420d
--- /dev/null
+++ b/tests/unit/test-xbox-volatile-hdd.c
@@ -0,0 +1,585 @@
+/*
+ * Volatile Original Xbox hard disk tests
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+
+#include "block/block-global-state.h"
+#include "block/block_int.h"
+#include "block/xbox-save-vault.h"
+#include "block/xbox-volatile-hdd.h"
+#include "qapi/error.h"
+#include "qemu/bswap.h"
+#include "qemu/cutils.h"
+#include "qemu/iov.h"
+#include "qemu/main-loop.h"
+#include "qemu/units.h"
+#include "system/block-backend.h"
+#include "system/block-backend-io.h"
+#include "tests/unit/xemu-gdox-test-security.h"
+
+#include <glib/gstdio.h>
+
+#define TEST_HDD_SIZE (XBOX_VOLATILE_HDD_E_END + MiB)
+#define TEST_SLOT_SIZE 512
+#define TEST_NOT_DONE INT_MAX
+
+typedef struct TestSlot {
+    int64_t offset;
+    uint8_t data[TEST_SLOT_SIZE];
+} TestSlot;
+
+typedef struct TestBackingState {
+    TestSlot slots[4];
+    bool valid_empty_e;
+    unsigned int write_count;
+    unsigned int zero_count;
+    unsigned int flush_count;
+    unsigned int discard_count;
+} TestBackingState;
+
+static char *test_vault_directory_new(void)
+{
+    return gdox_test_private_directory_new("xemu-volatile-vault-XXXXXX");
+}
+
+static void test_vault_directory_free(char *directory)
+{
+    static const char *const files[] = {
+        "original-xbox-udata.lock",
+        "original-xbox-udata-0.gdox",
+        "original-xbox-udata-1.gdox",
+        "original-xbox-udata-stage.gdox",
+        "original-xbox-migration-archive.gdox",
+        "original-xbox-migration-receipt-v1.gdox",
+    };
+
+    for (size_t i = 0; i < ARRAY_SIZE(files); i++) {
+        g_autofree char *path = g_build_filename(directory, files[i], NULL);
+
+        if (g_unlink(path) != 0) {
+            g_assert_cmpint(errno, ==, ENOENT);
+        }
+    }
+    g_assert_cmpint(g_rmdir(directory), ==, 0);
+    g_free(directory);
+}
+
+static const int64_t test_slot_offsets[] = {
+    XBOX_VOLATILE_HDD_CACHE_START - TEST_SLOT_SIZE,
+    XBOX_VOLATILE_HDD_CACHE_START,
+    XBOX_VOLATILE_HDD_CACHE_END,
+    XBOX_VOLATILE_HDD_CACHE_END + TEST_SLOT_SIZE,
+};
+
+static int test_backing_open(BlockDriverState *bs, QDict *options, int flags,
+                             Error **errp)
+{
+    TestBackingState *s = bs->opaque;
+
+    for (size_t i = 0; i < ARRAY_SIZE(s->slots); i++) {
+        s->slots[i].offset = test_slot_offsets[i];
+        memset(s->slots[i].data, 0xa5, sizeof(s->slots[i].data));
+    }
+    bs->total_sectors = TEST_HDD_SIZE / BDRV_SECTOR_SIZE;
+    bs->supported_write_flags = BDRV_REQ_FUA;
+    bs->supported_zero_flags = BDRV_REQ_FUA | BDRV_REQ_MAY_UNMAP |
+                               BDRV_REQ_NO_FALLBACK;
+    return 0;
+}
+
+static int64_t coroutine_fn GRAPH_RDLOCK
+test_backing_getlength(BlockDriverState *bs)
+{
+    return TEST_HDD_SIZE;
+}
+
+static TestSlot *test_backing_slot(TestBackingState *s, int64_t offset)
+{
+    for (size_t i = 0; i < ARRAY_SIZE(s->slots); i++) {
+        if (offset >= s->slots[i].offset &&
+            offset < s->slots[i].offset + TEST_SLOT_SIZE) {
+            return &s->slots[i];
+        }
+    }
+    return NULL;
+}
+
+static bool test_backing_empty_e_byte(int64_t offset, uint8_t *value)
+{
+    const uint64_t e_bytes = XBOX_VOLATILE_HDD_E_END -
+                             XBOX_VOLATILE_HDD_E_START;
+    const uint64_t clusters = e_bytes / (16U * KiB) + 1U;
+    const uint64_t fat_bytes = ROUND_UP(clusters * 4U, 4096U);
+    const uint64_t root_offset = XBOX_VOLATILE_HDD_E_START + 4096U +
+                                 fat_bytes;
+    uint64_t relative;
+
+    if (offset < XBOX_VOLATILE_HDD_E_START) {
+        return false;
+    }
+    relative = offset - XBOX_VOLATILE_HDD_E_START;
+    if (relative < 4096U) {
+        static const uint8_t header[16] = {
+            'F', 'A', 'T', 'X', 0U, 0U, 0U, 0U,
+            32U, 0U, 0U, 0U, 1U, 0U, 0U, 0U,
+        };
+
+        *value = relative < sizeof(header) ? header[relative] : 0U;
+        return true;
+    }
+    if (relative >= 4096U && relative < 4104U) {
+        static const uint8_t fat[8] = {
+            0xf8U, 0xffU, 0xffU, 0xffU,
+            0xffU, 0xffU, 0xffU, 0xffU,
+        };
+
+        *value = fat[relative - 4096U];
+        return true;
+    }
+    if ((uint64_t)offset >= root_offset &&
+        (uint64_t)offset < root_offset + 16U * KiB) {
+        *value = 0xffU;
+        return true;
+    }
+    return false;
+}
+
+static int coroutine_fn GRAPH_RDLOCK
+test_backing_preadv_part(BlockDriverState *bs, int64_t offset, int64_t bytes,
+                         QEMUIOVector *qiov, size_t qiov_offset,
+                         BdrvRequestFlags flags)
+{
+    TestBackingState *s = bs->opaque;
+    g_autofree uint8_t *buffer = g_malloc(bytes);
+
+    memset(buffer, 0xa5, bytes);
+    for (int64_t i = 0; i < bytes; i++) {
+        TestSlot *slot = test_backing_slot(s, offset + i);
+
+        if (slot) {
+            buffer[i] = slot->data[offset + i - slot->offset];
+        } else if (s->valid_empty_e) {
+            test_backing_empty_e_byte(offset + i, &buffer[i]);
+        }
+    }
+    qemu_iovec_from_buf(qiov, qiov_offset, buffer, bytes);
+    return 0;
+}
+
+static int coroutine_fn GRAPH_RDLOCK
+test_backing_pwritev_part(BlockDriverState *bs, int64_t offset, int64_t bytes,
+                          QEMUIOVector *qiov, size_t qiov_offset,
+                          BdrvRequestFlags flags)
+{
+    TestBackingState *s = bs->opaque;
+    g_autofree uint8_t *buffer = g_malloc(bytes);
+
+    s->write_count++;
+    qemu_iovec_to_buf(qiov, qiov_offset, buffer, bytes);
+    for (int64_t i = 0; i < bytes; i++) {
+        TestSlot *slot = test_backing_slot(s, offset + i);
+
+        if (slot) {
+            slot->data[offset + i - slot->offset] = buffer[i];
+        }
+    }
+    return 0;
+}
+
+static int coroutine_fn GRAPH_RDLOCK
+test_backing_zero(BlockDriverState *bs, int64_t offset, int64_t bytes,
+                  BdrvRequestFlags flags)
+{
+    TestBackingState *s = bs->opaque;
+
+    s->zero_count++;
+    for (int64_t i = 0; i < bytes; i++) {
+        TestSlot *slot = test_backing_slot(s, offset + i);
+
+        if (slot) {
+            slot->data[offset + i - slot->offset] = 0;
+        }
+    }
+    return 0;
+}
+
+static int coroutine_fn GRAPH_RDLOCK
+test_backing_discard(BlockDriverState *bs, int64_t offset, int64_t bytes)
+{
+    TestBackingState *s = bs->opaque;
+
+    s->discard_count++;
+    return test_backing_zero(bs, offset, bytes, 0);
+}
+
+static int coroutine_fn GRAPH_RDLOCK test_backing_flush(BlockDriverState *bs)
+{
+    TestBackingState *s = bs->opaque;
+
+    s->flush_count++;
+    return 0;
+}
+
+static BlockDriver test_backing_driver = {
+    .format_name             = "xbox-volatile-hdd-test-backing",
+    .instance_size           = sizeof(TestBackingState),
+    .bdrv_open               = test_backing_open,
+    .bdrv_co_getlength       = test_backing_getlength,
+    .bdrv_co_preadv_part     = test_backing_preadv_part,
+    .bdrv_co_pwritev_part    = test_backing_pwritev_part,
+    .bdrv_co_pwrite_zeroes   = test_backing_zero,
+    .bdrv_co_pdiscard        = test_backing_discard,
+    .bdrv_co_flush           = test_backing_flush,
+};
+
+static BlockBackend *test_backing_new(TestBackingState **state)
+{
+    BlockBackend *blk;
+    BlockDriverState *bs;
+
+    blk = blk_new(qemu_get_aio_context(), BLK_PERM_CONSISTENT_READ,
+                  BLK_PERM_ALL);
+    bs = bdrv_new_open_driver(&test_backing_driver, NULL,
+                              0, &error_abort);
+    *state = bs->opaque;
+    blk_insert_bs(blk, bs, &error_abort);
+    bdrv_unref(bs);
+    return blk;
+}
+
+static void assert_read_only_backing(BlockBackend *blk)
+{
+    BlockDriverState *overlay = blk_bs(blk);
+    uint64_t perm;
+    uint64_t shared_perm;
+
+    g_assert_nonnull(overlay->backing);
+    g_assert_false(bdrv_is_read_only(overlay));
+    g_assert_true(bdrv_is_read_only(overlay->backing->bs));
+    blk_get_perm(blk, &perm, &shared_perm);
+    g_assert_true(perm & BLK_PERM_CONSISTENT_READ);
+    g_assert_true(perm & BLK_PERM_WRITE);
+    g_assert_cmphex(shared_perm, ==, BLK_PERM_ALL);
+}
+
+static void test_aio_done(void *opaque, int ret)
+{
+    *(int *)opaque = ret;
+}
+
+static uint32_t get_le32(const uint8_t *source)
+{
+    return source[0] | (source[1] << 8) | (source[2] << 16) |
+           (source[3] << 24);
+}
+
+static void test_blank_fatx(void)
+{
+    static const int64_t offsets[] = {
+        UINT64_C(0x00080000), UINT64_C(0x2ee80000),
+        UINT64_C(0x5dc80000),
+    };
+    static const uint32_t volume_ids[] = {
+        UINT32_C(0x000d0137), UINT32_C(0x000d01d4),
+        UINT32_C(0x000d02a4),
+    };
+    TestBackingState *state;
+    BlockBackend *blk = test_backing_new(&state);
+    uint8_t metadata[8192];
+
+    g_assert_true(xbox_volatile_hdd_attach(blk, &error_abort));
+    assert_read_only_backing(blk);
+    for (size_t i = 0; i < ARRAY_SIZE(offsets); i++) {
+        g_assert_cmpint(blk_pread(blk, offsets[i], sizeof(metadata), metadata,
+                                  0), ==, 0);
+        g_assert_cmpmem(metadata, 4, "FATX", 4);
+        g_assert_cmphex(get_le32(metadata + 4), ==, volume_ids[i]);
+        g_assert_cmphex(get_le32(metadata + 8), ==, 32);
+        g_assert_cmphex(get_le32(metadata + 12), ==, 1);
+        g_assert_cmphex(metadata[4096], ==, 0xf8);
+        g_assert_cmphex(metadata[4097], ==, 0xff);
+        g_assert_true(buffer_is_zero(metadata + 4100,
+                                     sizeof(metadata) - 4100));
+    }
+    g_assert_cmphex(state->slots[1].data[0], ==, 0xa5);
+    blk_unref(blk);
+}
+
+static void test_full_disk_cow_and_boundaries(void)
+{
+    TestBackingState *state;
+    BlockBackend *blk = test_backing_new(&state);
+    uint8_t write_buffer[TEST_SLOT_SIZE * 2];
+    uint8_t read_buffer[sizeof(write_buffer)];
+
+    memset(write_buffer, 0x3c, sizeof(write_buffer));
+    g_assert_true(xbox_volatile_hdd_attach(blk, &error_abort));
+    assert_read_only_backing(blk);
+    g_assert_cmpint(blk_pwrite(blk, XBOX_VOLATILE_HDD_CACHE_START - TEST_SLOT_SIZE,
+                              sizeof(write_buffer), write_buffer, 0), ==, 0);
+    g_assert_cmphex(state->slots[0].data[0], ==, 0xa5);
+    g_assert_cmphex(state->slots[1].data[0], ==, 0xa5);
+    memset(read_buffer, 0, sizeof(read_buffer));
+    g_assert_cmpint(blk_pread(blk, XBOX_VOLATILE_HDD_CACHE_START - TEST_SLOT_SIZE,
+                             sizeof(read_buffer), read_buffer, 0), ==, 0);
+    g_assert_cmpmem(read_buffer, sizeof(read_buffer), write_buffer,
+                    sizeof(write_buffer));
+
+    memset(write_buffer, 0x7e, TEST_SLOT_SIZE);
+    g_assert_cmpint(blk_pwrite(blk, XBOX_VOLATILE_HDD_CACHE_END,
+                              TEST_SLOT_SIZE, write_buffer, 0), ==, 0);
+    g_assert_cmphex(state->slots[2].data[0], ==, 0xa5);
+
+    g_assert_cmpint(blk_flush(blk), ==, 0);
+    g_assert_cmpuint(state->write_count, ==, 0);
+    g_assert_cmpuint(state->zero_count, ==, 0);
+    g_assert_cmpuint(state->flush_count, ==, 0);
+    blk_unref(blk);
+}
+
+static void test_zero_discard_and_failure(void)
+{
+    TestBackingState *state;
+    BlockBackend *blk = test_backing_new(&state);
+    uint8_t buffer[TEST_SLOT_SIZE];
+    Error *error = NULL;
+
+    memset(buffer, 0x9b, sizeof(buffer));
+    g_assert_false(xbox_volatile_hdd_attach_with_page_limit(blk, 2, &error));
+    g_assert_nonnull(error);
+    error_free(error);
+    blk_unref(blk);
+
+    blk = test_backing_new(&state);
+    g_assert_true(xbox_volatile_hdd_attach_with_page_limit(blk, 4,
+                                                           &error_abort));
+    assert_read_only_backing(blk);
+    g_assert_cmpint(blk_pwrite(blk, XBOX_VOLATILE_HDD_CACHE_START +
+                                   XBOX_VOLATILE_HDD_PAGE_SIZE,
+                              sizeof(buffer), buffer, 0), ==, 0);
+    g_assert_cmpint(blk_pwrite(blk, XBOX_VOLATILE_HDD_CACHE_START +
+                                   2 * XBOX_VOLATILE_HDD_PAGE_SIZE,
+                              sizeof(buffer), buffer, 0), ==, -ENOSPC);
+    g_assert_cmpint(blk_pwrite_zeroes(blk, XBOX_VOLATILE_HDD_CACHE_START +
+                                          XBOX_VOLATILE_HDD_PAGE_SIZE,
+                                     XBOX_VOLATILE_HDD_PAGE_SIZE, 0), ==, 0);
+    g_assert_cmpint(blk_pwrite(blk, XBOX_VOLATILE_HDD_CACHE_START +
+                                   2 * XBOX_VOLATILE_HDD_PAGE_SIZE,
+                              sizeof(buffer), buffer, 0), ==, 0);
+    g_assert_cmpint(blk_pdiscard(blk, XBOX_VOLATILE_HDD_CACHE_START +
+                                     2 * XBOX_VOLATILE_HDD_PAGE_SIZE,
+                                XBOX_VOLATILE_HDD_PAGE_SIZE), ==, 0);
+    g_assert_cmpint(blk_pwrite(blk, XBOX_VOLATILE_HDD_CACHE_START +
+                                   3 * XBOX_VOLATILE_HDD_PAGE_SIZE,
+                              sizeof(buffer), buffer, 0), ==, 0);
+
+    g_assert_cmpint(blk_pwrite_zeroes(blk, XBOX_VOLATILE_HDD_CACHE_START,
+                                     sizeof(buffer), 0), ==, 0);
+    memset(buffer, 0xff, sizeof(buffer));
+    g_assert_cmpint(blk_pread(blk, XBOX_VOLATILE_HDD_CACHE_START,
+                             sizeof(buffer), buffer, 0), ==, 0);
+    g_assert_true(buffer_is_zero(buffer, sizeof(buffer)));
+
+    memset(buffer, 0x11, sizeof(buffer));
+    g_assert_cmpint(blk_pwrite(blk, XBOX_VOLATILE_HDD_CACHE_START,
+                              sizeof(buffer), buffer, 0), ==, 0);
+    g_assert_cmpint(blk_pdiscard(blk, XBOX_VOLATILE_HDD_CACHE_START,
+                                sizeof(buffer)), ==, 0);
+    g_assert_cmpint(blk_pread(blk, XBOX_VOLATILE_HDD_CACHE_START,
+                             sizeof(buffer), buffer, 0), ==, 0);
+    g_assert_true(buffer_is_zero(buffer, sizeof(buffer)));
+
+    g_assert_cmpint(blk_pdiscard(blk, XBOX_VOLATILE_HDD_CACHE_END,
+                                XBOX_VOLATILE_HDD_PAGE_SIZE), ==, 0);
+    memset(buffer, 0xff, sizeof(buffer));
+    g_assert_cmpint(blk_pread(blk, XBOX_VOLATILE_HDD_CACHE_END,
+                             sizeof(buffer), buffer, 0), ==, 0);
+    g_assert_true(buffer_is_zero(buffer, sizeof(buffer)));
+    g_assert_cmpuint(state->write_count, ==, 0);
+    g_assert_cmpuint(state->zero_count, ==, 0);
+    g_assert_cmpuint(state->discard_count, ==, 0);
+    blk_unref(blk);
+}
+
+static void test_concurrent_write_discard(void)
+{
+    TestBackingState *state;
+    BlockBackend *blk = test_backing_new(&state);
+    g_autofree uint8_t *write_buffer =
+        g_malloc(XBOX_VOLATILE_HDD_PAGE_SIZE);
+    uint8_t read_buffer[TEST_SLOT_SIZE];
+    QEMUIOVector qiov;
+
+    memset(write_buffer, 0x5a, XBOX_VOLATILE_HDD_PAGE_SIZE);
+    qemu_iovec_init(&qiov, 1);
+    qemu_iovec_add(&qiov, write_buffer, XBOX_VOLATILE_HDD_PAGE_SIZE);
+    g_assert_true(xbox_volatile_hdd_attach_with_page_limit(
+        blk, 4, &error_abort));
+    assert_read_only_backing(blk);
+
+    for (unsigned int i = 0; i < 128; i++) {
+        int write_ret = TEST_NOT_DONE;
+        int discard_ret = TEST_NOT_DONE;
+        bool all_written = true;
+
+        blk_aio_pwritev(blk, XBOX_VOLATILE_HDD_CACHE_END, &qiov, 0,
+                        test_aio_done, &write_ret);
+        blk_aio_pdiscard(blk, XBOX_VOLATILE_HDD_CACHE_END,
+                         XBOX_VOLATILE_HDD_PAGE_SIZE,
+                         test_aio_done, &discard_ret);
+        while (write_ret == TEST_NOT_DONE || discard_ret == TEST_NOT_DONE) {
+            main_loop_wait(false);
+        }
+        g_assert_cmpint(write_ret, ==, 0);
+        g_assert_cmpint(discard_ret, ==, 0);
+        g_assert_cmpint(blk_pread(blk, XBOX_VOLATILE_HDD_CACHE_END,
+                                 sizeof(read_buffer), read_buffer, 0), ==, 0);
+        for (size_t byte = 0; byte < sizeof(read_buffer); byte++) {
+            all_written &= read_buffer[byte] == 0x5a;
+        }
+        g_assert_true(all_written ||
+                      buffer_is_zero(read_buffer, sizeof(read_buffer)));
+    }
+
+    g_assert_cmphex(state->slots[2].data[0], ==, 0xa5);
+    g_assert_cmpuint(state->write_count, ==, 0);
+    g_assert_cmpuint(state->zero_count, ==, 0);
+    g_assert_cmpuint(state->discard_count, ==, 0);
+    qemu_iovec_destroy(&qiov);
+    blk_unref(blk);
+}
+
+static void test_cache_only_write_skips_save_scan(void)
+{
+    g_autofree char *directory = test_vault_directory_new();
+    TestBackingState *state;
+    BlockBackend *blk = test_backing_new(&state);
+    uint8_t buffer[TEST_SLOT_SIZE];
+
+    memset(buffer, 0x42, sizeof(buffer));
+    g_setenv(XBOX_SAVE_VAULT_ENVIRONMENT, directory, true);
+    g_assert_true(xbox_volatile_hdd_attach(blk, &error_abort));
+    assert_read_only_backing(blk);
+    g_assert_cmpint(blk_pwrite(blk, XBOX_VOLATILE_HDD_CACHE_START,
+                              sizeof(buffer), buffer, 0), ==, 0);
+    /* The synthetic backing has no E: FATX volume; a scan would fail. */
+    g_assert_cmpint(blk_flush(blk), ==, 0);
+    g_assert_cmpint(xbox_volatile_hdd_adjust_exit_status(EXIT_SUCCESS),
+                    ==, EXIT_SUCCESS);
+    blk_unref(blk);
+    g_unsetenv(XBOX_SAVE_VAULT_ENVIRONMENT);
+    test_vault_directory_free(g_steal_pointer(&directory));
+}
+
+static void test_checkpoint_failure_retry_and_exit_status(void)
+{
+    const uint64_t e_bytes = XBOX_VOLATILE_HDD_E_END -
+                             XBOX_VOLATILE_HDD_E_START;
+    const uint64_t clusters = e_bytes / (16U * KiB) + 1U;
+    const uint64_t fat_bytes = ROUND_UP(clusters * 4U, 4096U);
+    const uint64_t root_offset = XBOX_VOLATILE_HDD_E_START + 4096U +
+                                 fat_bytes;
+    g_autofree char *directory = test_vault_directory_new();
+    g_autofree uint8_t *root = g_malloc(16U * KiB);
+    TestBackingState *state;
+    BlockBackend *blk = test_backing_new(&state);
+    uint8_t marker = 0x7a;
+    uint8_t superblock[4096] = { 0 };
+    uint8_t fat[8];
+
+    g_setenv(XBOX_SAVE_VAULT_ENVIRONMENT, directory, true);
+    g_assert_true(xbox_volatile_hdd_attach(blk, &error_abort));
+    assert_read_only_backing(blk);
+    g_assert_cmpint(blk_pwrite(blk, XBOX_VOLATILE_HDD_E_START + 2U * MiB,
+                              sizeof(marker), &marker, 0), ==, 0);
+    g_assert_cmpint(blk_flush(blk), ==, -EIO);
+    g_assert_true(xbox_volatile_hdd_save_failed());
+    g_assert_cmpint(xbox_volatile_hdd_adjust_exit_status(EXIT_SUCCESS),
+                    ==, EXIT_FAILURE);
+
+    memcpy(superblock, "FATX", 4U);
+    stl_le_p(superblock + 8U, 32U);
+    stl_le_p(superblock + 12U, 1U);
+    stl_le_p(fat, UINT32_C(0xfffffff8));
+    stl_le_p(fat + 4U, UINT32_MAX);
+    memset(root, 0xff, 16U * KiB);
+    g_assert_cmpint(blk_pwrite(blk, 0x100U, sizeof(marker), &marker, 0), ==, 0);
+    g_assert_cmpint(blk_pwrite(blk, XBOX_VOLATILE_HDD_E_START,
+                              sizeof(superblock), superblock, 0), ==, 0);
+    g_assert_cmpint(blk_pwrite(blk, XBOX_VOLATILE_HDD_E_START + 4096U,
+                              sizeof(fat), fat, 0), ==, 0);
+    g_assert_cmpint(blk_pwrite(blk, root_offset, 16U * KiB, root, 0), ==, 0);
+    g_assert_cmpint(blk_flush(blk), ==, 0);
+    g_assert_false(xbox_volatile_hdd_save_failed());
+    g_assert_cmpint(xbox_volatile_hdd_adjust_exit_status(EXIT_SUCCESS),
+                    ==, EXIT_SUCCESS);
+
+    blk_unref(blk);
+    blk = test_backing_new(&state);
+    state->valid_empty_e = true;
+    marker = 0U;
+    g_assert_true(xbox_volatile_hdd_attach(blk, &error_abort));
+    assert_read_only_backing(blk);
+    g_assert_cmpint(blk_pread(blk, 0x100U, sizeof(marker), &marker, 0), ==, 0);
+    g_assert_cmphex(marker, ==, 0x7a);
+    g_assert_cmpuint(state->write_count, ==, 0);
+    blk_unref(blk);
+    g_unsetenv(XBOX_SAVE_VAULT_ENVIRONMENT);
+    test_vault_directory_free(g_steal_pointer(&directory));
+}
+
+static void test_import_failure_detaches_overlay(void)
+{
+    static const uint8_t corrupt[] = "invalid vault";
+    g_autofree char *directory = test_vault_directory_new();
+    g_autofree char *slot = g_build_filename(
+        directory, "original-xbox-udata-0.gdox", NULL);
+    TestBackingState *state;
+    BlockBackend *blk = test_backing_new(&state);
+    Error *error = NULL;
+    int fd = g_open(slot, O_WRONLY | O_CREAT | O_EXCL | O_BINARY, 0600);
+
+    g_assert_cmpint(fd, >=, 0);
+    g_assert_cmpint(qemu_write_full(fd, corrupt, sizeof(corrupt)),
+                    ==, sizeof(corrupt));
+    g_assert_cmpint(qemu_close(fd), ==, 0);
+    g_setenv(XBOX_SAVE_VAULT_ENVIRONMENT, directory, true);
+    g_assert_false(xbox_volatile_hdd_attach(blk, &error));
+    g_assert_nonnull(error);
+    error_free(error);
+    g_assert_true(blk_bs(blk)->drv == &test_backing_driver);
+    g_assert_null(blk_bs(blk)->backing);
+    blk_unref(blk);
+    g_unsetenv(XBOX_SAVE_VAULT_ENVIRONMENT);
+    g_assert_cmpint(g_unlink(slot), ==, 0);
+    test_vault_directory_free(g_steal_pointer(&directory));
+}
+
+int main(int argc, char **argv)
+{
+#ifdef XBOX
+    qemu_init_main_loop_lock();
+    qemu_mutex_lock_main_loop();
+#endif
+    bdrv_init();
+    qemu_init_main_loop(&error_abort);
+    g_test_init(&argc, &argv, NULL);
+
+    g_test_add_func("/xbox-volatile-hdd/blank-fatx", test_blank_fatx);
+    g_test_add_func("/xbox-volatile-hdd/full-disk-cow-and-boundaries",
+                    test_full_disk_cow_and_boundaries);
+    g_test_add_func("/xbox-volatile-hdd/zero-discard-and-failure",
+                    test_zero_discard_and_failure);
+    g_test_add_func("/xbox-volatile-hdd/concurrent-write-discard",
+                    test_concurrent_write_discard);
+    g_test_add_func("/xbox-volatile-hdd/cache-only-write-skips-save-scan",
+                    test_cache_only_write_skips_save_scan);
+    g_test_add_func("/xbox-volatile-hdd/checkpoint-failure-retry-exit-status",
+                    test_checkpoint_failure_retry_and_exit_status);
+    g_test_add_func("/xbox-volatile-hdd/import-failure-detaches-overlay",
+                    test_import_failure_detaches_overlay);
+    return g_test_run();
+}
diff --git a/tests/unit/test-xemu-gdox-runtime.c b/tests/unit/test-xemu-gdox-runtime.c
new file mode 100644
index 0000000..891e63e
--- /dev/null
+++ b/tests/unit/test-xemu-gdox-runtime.c
@@ -0,0 +1,150 @@
+/*
+ * GDOX launch argument tests
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+
+#include "ui/xemu-gdox-runtime.h"
+
+static void test_disabled(void)
+{
+    const char *argv[] = { "xemu", "-config_path", "xemu.toml", NULL };
+    XemuGdoxLaunch launch;
+    int argc = 3;
+
+    g_setenv("MESA_SHADER_CACHE_DISABLE", "preserved", true);
+    g_assert_true(xemu_gdox_launch_prepare(&argc, (char **)argv, &launch));
+    g_assert_cmpint(launch.mode, ==, XEMU_GDOX_LAUNCH_NORMAL);
+    g_assert_cmpint(argc, ==, 3);
+    g_assert_cmpstr(g_getenv("MESA_SHADER_CACHE_DISABLE"), ==, "preserved");
+}
+
+static void test_runtime(void)
+{
+    const char *argv[] = {
+        "xemu", XEMU_GDOX_RUNTIME_ARGUMENT,
+        XEMU_GDOX_SAVE_VAULT_ARGUMENT, "/private/gdox/saves",
+        "-config_path", "xemu.toml", NULL,
+    };
+    XemuGdoxLaunch launch;
+    int argc = 6;
+
+    g_assert_true(xemu_gdox_launch_prepare(&argc, (char **)argv, &launch));
+    g_assert_cmpint(launch.mode, ==, XEMU_GDOX_LAUNCH_RUNTIME);
+    g_assert_cmpint(argc, ==, 3);
+    g_assert_cmpstr(g_getenv(XEMU_GDOX_SAVE_VAULT_ENVIRONMENT), ==,
+                    "/private/gdox/saves");
+    g_assert_cmpstr(g_getenv("MESA_SHADER_CACHE_DISABLE"), ==, "1");
+    g_assert_cmpstr(g_getenv("__GL_SHADER_DISK_CACHE"), ==, "0");
+}
+
+static void test_runtime_invalid(void)
+{
+    const char *missing[] = { "xemu", XEMU_GDOX_RUNTIME_ARGUMENT, NULL };
+    const char *duplicate[] = {
+        "xemu", XEMU_GDOX_RUNTIME_ARGUMENT,
+        XEMU_GDOX_SAVE_VAULT_ARGUMENT, "/private/a",
+        XEMU_GDOX_SAVE_VAULT_ARGUMENT, "/private/b", NULL,
+    };
+    XemuGdoxLaunch launch;
+    int missing_argc = 2;
+    int duplicate_argc = 6;
+
+    g_assert_false(xemu_gdox_launch_prepare(
+        &missing_argc, (char **)missing, &launch));
+    g_assert_false(xemu_gdox_launch_prepare(
+        &duplicate_argc, (char **)duplicate, &launch));
+}
+
+static void test_migration(void)
+{
+    const char *argv[] = {
+        "xemu", XEMU_GDOX_EXPECTED_SHA_ARGUMENT,
+        "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
+        XEMU_GDOX_SAVE_VAULT_ARGUMENT, "/private/vault",
+        XEMU_GDOX_MIGRATE_ARGUMENT, "/private/legacy.qcow2",
+        XEMU_GDOX_EXPECTED_BYTES_ARGUMENT, "1782120448",
+        XEMU_GDOX_CLEAN_HDD_ARGUMENT, "/runtime/clean.qcow2", NULL,
+    };
+    XemuGdoxLaunch launch;
+    int argc = 11;
+
+    g_assert_true(xemu_gdox_launch_prepare(&argc, (char **)argv, &launch));
+    g_assert_cmpint(launch.mode, ==, XEMU_GDOX_LAUNCH_MIGRATE);
+    g_assert_cmpint(argc, ==, 1);
+    g_assert_cmpstr(launch.migration.legacy_hdd, ==,
+                    "/private/legacy.qcow2");
+    g_assert_cmpuint(launch.migration.expected_source_bytes,
+                     ==, UINT64_C(1782120448));
+    g_assert_cmphex(launch.migration.expected_source_sha256[0], ==, 0x01);
+    g_assert_cmphex(launch.migration.expected_source_sha256[31], ==, 0xef);
+    g_assert_true(launch.migration.expected_source_sha256_valid);
+}
+
+static void test_migration_removal_without_expected_hash(void)
+{
+    const char *argv[] = {
+        "xemu", XEMU_GDOX_MIGRATE_ARGUMENT, "/private/legacy.qcow2",
+        XEMU_GDOX_REMOVE_SOURCE_ARGUMENT,
+        XEMU_GDOX_CLEAN_HDD_ARGUMENT, "/runtime/clean.qcow2",
+        XEMU_GDOX_SAVE_VAULT_ARGUMENT, "/private/vault",
+        XEMU_GDOX_EXPECTED_BYTES_ARGUMENT, "1782120448", NULL,
+    };
+    XemuGdoxLaunch launch;
+    int argc = 10;
+
+    g_assert_true(xemu_gdox_launch_prepare(&argc, (char **)argv, &launch));
+    g_assert_cmpint(launch.mode, ==, XEMU_GDOX_LAUNCH_MIGRATE_REMOVE);
+    g_assert_cmpint(argc, ==, 1);
+    g_assert_false(launch.migration.expected_source_sha256_valid);
+}
+
+static void test_migration_invalid_expectations(void)
+{
+    const char *uppercase[] = {
+        "xemu", XEMU_GDOX_MIGRATE_ARGUMENT, "/private/legacy.qcow2",
+        XEMU_GDOX_CLEAN_HDD_ARGUMENT, "/runtime/clean.qcow2",
+        XEMU_GDOX_SAVE_VAULT_ARGUMENT, "/private/vault",
+        XEMU_GDOX_EXPECTED_BYTES_ARGUMENT, "01",
+        XEMU_GDOX_EXPECTED_SHA_ARGUMENT,
+        "ABCDEF6789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
+        NULL,
+    };
+    XemuGdoxLaunch launch;
+    int argc = 11;
+
+    g_assert_false(xemu_gdox_launch_prepare(
+        &argc, (char **)uppercase, &launch));
+}
+
+static void test_validation(void)
+{
+    const char *argv[] = {
+        "xemu", XEMU_GDOX_CLEAN_HDD_ARGUMENT, "/runtime/clean.qcow2",
+        XEMU_GDOX_VALIDATE_ARGUMENT, "/private/vault", NULL,
+    };
+    XemuGdoxLaunch launch;
+    int argc = 5;
+
+    g_assert_true(xemu_gdox_launch_prepare(&argc, (char **)argv, &launch));
+    g_assert_cmpint(launch.mode, ==, XEMU_GDOX_LAUNCH_VALIDATE);
+    g_assert_cmpint(argc, ==, 1);
+    g_assert_cmpstr(launch.validation_vault, ==, "/private/vault");
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    g_test_add_func("/xemu-gdox-launch/disabled", test_disabled);
+    g_test_add_func("/xemu-gdox-launch/runtime", test_runtime);
+    g_test_add_func("/xemu-gdox-launch/runtime-invalid", test_runtime_invalid);
+    g_test_add_func("/xemu-gdox-launch/migration", test_migration);
+    g_test_add_func("/xemu-gdox-launch/migration-invalid-expectations",
+                    test_migration_invalid_expectations);
+    g_test_add_func("/xemu-gdox-launch/migration-removal-no-expected-hash",
+                    test_migration_removal_without_expected_hash);
+    g_test_add_func("/xemu-gdox-launch/validation", test_validation);
+    return g_test_run();
+}
diff --git a/tests/unit/test-xemu-version.sh b/tests/unit/test-xemu-version.sh
new file mode 100755
index 0000000..09130a6
--- /dev/null
+++ b/tests/unit/test-xemu-version.sh
@@ -0,0 +1,32 @@
+#!/bin/bash
+
+set -eu
+
+source_root="$1"
+temporary=$(mktemp -d)
+trap 'rm -rf "$temporary"' EXIT
+
+printf '%s\n' '0000000000000000000000000000000000000000' \
+  > "$temporary/XEMU_COMMIT"
+printf '%s\n' '1.2.3' > "$temporary/XEMU_VERSION"
+
+first=$(SOURCE_DATE_EPOCH=946684800 \
+  "$source_root/scripts/xemu-version.sh" "$temporary")
+second=$(SOURCE_DATE_EPOCH=946684800 \
+  "$source_root/scripts/xemu-version.sh" "$temporary")
+
+test "$first" = "$second"
+printf '%s\n' "$first" | grep -Fq \
+  '#define XEMU_DATE          "2000-01-01T00:00:00Z"'
+
+if SOURCE_DATE_EPOCH=-1 \
+    "$source_root/scripts/xemu-version.sh" "$temporary" >/dev/null 2>&1; then
+  echo "negative SOURCE_DATE_EPOCH was accepted" >&2
+  exit 1
+fi
+
+if SOURCE_DATE_EPOCH=invalid \
+    "$source_root/scripts/xemu-version.sh" "$temporary" >/dev/null 2>&1; then
+  echo "non-numeric SOURCE_DATE_EPOCH was accepted" >&2
+  exit 1
+fi
