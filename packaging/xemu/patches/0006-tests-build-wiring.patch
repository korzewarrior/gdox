+    g_assert_true(xbox_save_receipt_store(directory, &stored, &error_abort));
+    g_assert_true(xbox_save_receipt_load(directory, &loaded, &exists,
+                                         &valid, &error_abort));
+    g_assert_true(exists);
+    g_assert_true(valid);
+    g_assert_cmpmem(&loaded, sizeof(loaded), &stored, sizeof(stored));
+
+    vault.vault_version = 2U;
+    vault.generation = 8U;
+    vault.entries = 13U;
+    vault.logical_bytes = 16384U;
+    vault.policy_revision = stored.policy_revision;
+    memcpy(vault.policy_sha256, stored.policy_sha256, 32U);
+    memset(vault.tree_sha256, 0x66, sizeof(vault.tree_sha256));
+    g_assert_true(xbox_save_receipt_refresh_vault(
+        directory, &vault, &error_abort));
+    g_assert_true(xbox_save_receipt_load(directory, &loaded, &exists,
+                                         &valid, &error_abort));
+    g_assert_true(valid);
+    g_assert_cmpuint(loaded.vault_generation, ==, 8U);
+    g_assert_cmpmem(loaded.vault_tree_sha256, 32U,
+                    vault.tree_sha256, 32U);
+    g_assert_cmpuint(loaded.unclassified_tdata_entries, ==, 1U);
+
+    fd = g_open(path, O_RDWR | O_BINARY, 0600);
+    g_assert_cmpint(fd, >=, 0);
+    g_assert_cmpint(lseek(fd, 56U, SEEK_SET), ==, 56);
+    g_assert_cmpint(read(fd, &byte, 1U), ==, 1);
+    byte ^= 0x80U;
+    g_assert_cmpint(lseek(fd, 56U, SEEK_SET), ==, 56);
+    g_assert_cmpint(qemu_write_full(fd, &byte, 1U), ==, 1);
+    g_assert_cmpint(qemu_close(fd), ==, 0);
+    g_assert_true(xbox_save_receipt_load(directory, &loaded, &exists,
+                                         &valid, &error_abort));
+    g_assert_true(exists);
+    g_assert_false(valid);
+
+    test_directory_free(g_steal_pointer(&directory));
+}
