+static void test_allocation_failure_is_controlled(void)
+{
+#ifndef _WIN32
+    const uint64_t maximum_pack = TEST_HEADER_V2_BYTES + 16U * MiB +
+                                  512U * MiB + TEST_DIGEST_BYTES;
+    g_autofree char *directory = test_directory_new();
+    g_autofree char *slot = test_slot_path(directory, 0U);
+    struct rlimit limit = { 256U * MiB, 256U * MiB };
+    pid_t child;
+    int fd = g_open(slot, O_WRONLY | O_CREAT | O_EXCL | O_BINARY, 0600);
+    int status;
+
+    g_assert_cmpint(fd, >=, 0);
+    g_assert_cmpint(ftruncate(fd, maximum_pack), ==, 0);
+    g_assert_cmpint(qemu_close(fd), ==, 0);
+    child = fork();
+    g_assert_cmpint(child, >=, 0);
+    if (child == 0) {
+        Error *error = NULL;
+        bool valid;
+
+        if (setrlimit(RLIMIT_AS, &limit) != 0) {
+            _exit(77);
+        }
+        valid = xbox_save_vault_validate(directory, &error);
+        _exit(!valid && error &&
+              strstr(error_get_pretty(error), "allocate memory") ? 0 : 1);
+    }
+    g_assert_cmpint(waitpid(child, &status, 0), ==, child);
+    if (WIFEXITED(status) && WEXITSTATUS(status) == 77) {
+        g_test_skip("RLIMIT_AS is unavailable");
+    } else {
+        g_assert_true(WIFEXITED(status));
+        g_assert_cmpint(WEXITSTATUS(status), ==, 0);
+    }
+    test_directory_free(g_steal_pointer(&directory));
+#endif
+}
