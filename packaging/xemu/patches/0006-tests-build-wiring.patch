+                    test_private_and_symlink_boundaries);
+    g_test_add_func("/xbox-save-vault/invalid-path-and-generation-exhaustion",
+                    test_invalid_path_and_generation_exhaustion);
+    g_test_add_func("/xbox-save-vault/allocation-failure-is-controlled",
+                    test_allocation_failure_is_controlled);
+    g_test_add_func("/xbox-save-vault/migration-transaction",
+                    test_migration_transaction);
+    g_test_add_func("/xbox-save-vault/migration-failure-leaves-vault-empty",
+                    test_migration_failure_leaves_vault_empty);
+    g_test_add_func("/xbox-save-vault/migration-idempotent-and-differing",
+                    test_migration_idempotent_and_differing);
+    g_test_add_func("/xbox-save-vault/migration-empty-stale-publication-race",
+                    test_migration_empty_stale_and_publication_race);
+    g_test_add_func("/xbox-save-vault/migration-roundtrip-corruption",
+                    test_migration_roundtrip_corruption);
+    g_test_add_func("/xbox-save-vault/checkpoint-noop-failure-preserves",
+                    test_checkpoint_noop_and_failure_preserves_generation);
+    g_test_add_func("/xbox-save-vault/receipt-roundtrip-refresh-tamper",
+                    test_receipt_roundtrip_refresh_and_tamper);
+    g_test_add_func("/xbox-save-vault/source-identity-same-size-mutation",
+                    test_same_size_mutation_changes_source_identity);
+    g_test_add_func("/xbox-save-vault/tdata-empty-and-zero-byte-inventory",
+                    test_tdata_empty_directories_and_zero_byte_inventory);
+#ifndef _WIN32
+    g_test_add_func("/xbox-save-vault/real-raw-and-qcow2-migration",
+                    test_real_raw_and_qcow2_migration);
+#endif
+    return g_test_run();
+}
