+#ifndef _WIN32
+static void test_disk_write_file(TestDisk *disk, const char *path)
+{
+    GHashTableIter iterator;
+    gpointer key;
+    gpointer value;
+    int fd = g_open(path, O_WRONLY | O_CREAT | O_EXCL | O_BINARY, 0600);
+
+    g_assert_cmpint(fd, >=, 0);
+    g_assert_cmpint(ftruncate(fd, XBOX_VOLATILE_HDD_E_END), ==, 0);
+    g_hash_table_iter_init(&iterator, disk->pages);
+    while (g_hash_table_iter_next(&iterator, &key, &value)) {
+        uint64_t offset = *(uint64_t *)key * TEST_PAGE_BYTES;
+        size_t remaining = TEST_PAGE_BYTES;
+        const uint8_t *cursor = value;
+
+        while (remaining > 0U) {
+            ssize_t written = RETRY_ON_EINTR(
+                pwrite(fd, cursor, remaining, offset));
+
+            g_assert_cmpint(written, >, 0);
+            cursor += written;
+            remaining -= written;
+            offset += written;
+        }
+    }
+    g_assert_cmpint(qemu_close(fd), ==, 0);
+}
