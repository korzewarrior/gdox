+        int fd = g_open(empty_quarantine_marker,
+                        O_RDWR | O_CREAT | O_EXCL | O_BINARY, 0600);
+
+        g_assert_cmpint(fd, >=, 0);
+        g_assert_cmpint(qemu_close(fd), ==, 0);
+    }
+    g_assert_false(xbox_save_migration_execute(
+        &request, &migration, &expected_error));
+    g_assert_nonnull(expected_error);
+    g_assert_nonnull(strstr(error_get_pretty(expected_error),
+                            "Multiple Xbox HDD removal quarantines"));
+    error_free(expected_error);
+    expected_error = NULL;
+    g_assert_cmpint(g_unlink(other_quarantine), ==, 0);
+    g_assert_true(xbox_save_migration_execute(
+        &request, &migration, &error_abort));
+    g_assert_true(migration.source_hashed);
+    g_assert_true(migration.source_projection_complete);
+    g_assert_true(migration.source_removal_safe);
+    g_assert_true(migration.source_removed);
+    g_assert_false(g_file_test(empty_qcow, G_FILE_TEST_EXISTS));
+    g_assert_false(g_file_test(quarantine, G_FILE_TEST_EXISTS));
+    g_assert_false(g_file_test(empty_quarantine_marker,
+                               G_FILE_TEST_EXISTS));
+
+    test_directory_free(g_steal_pointer(&seed_vault));
+    test_directory_free(g_steal_pointer(&raw_vault));
+    test_directory_free(g_steal_pointer(&qcow_vault));
+    test_directory_free(g_steal_pointer(&empty_vault));
+    test_directory_free(g_steal_pointer(&backed_vault));
+    g_assert_cmpint(g_unlink(source_raw), ==, 0);
+    g_assert_cmpint(g_unlink(source_qcow), ==, 0);
+    g_assert_cmpint(g_unlink(clean_raw), ==, 0);
+    g_assert_cmpint(g_unlink(clean_qcow), ==, 0);
+    g_assert_cmpint(g_unlink(empty_raw), ==, 0);
+    g_assert_cmpint(g_unlink(backed_qcow), ==, 0);
+    g_assert_cmpint(g_rmdir(files), ==, 0);
+}
+#endif
