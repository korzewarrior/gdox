+    :
+  elif XEMU_DATE=$(date -u -r "$SOURCE_DATE_EPOCH" \
+      "$timestamp_format" 2>/dev/null); then
+    :
+  else
+    echo "SOURCE_DATE_EPOCH is outside the range supported by date" >&2
+    exit 1
+  fi
