+#ifndef _WIN32
+static bool migration_quarantine_name_valid(const char *name)
+{
+    static const char prefix[] = ".gdox-xbox-hdd-removal.";
+    const size_t prefix_bytes = sizeof(prefix) - 1U;
+
+    if (!g_str_has_prefix(name, prefix) ||
+        strlen(name) != prefix_bytes + 8U + 1U + 8U ||
+        name[prefix_bytes + 8U] != '.') {
+        return false;
+    }
+    for (size_t i = prefix_bytes; i < prefix_bytes + 8U; i++) {
+        if (!g_ascii_isxdigit(name[i])) {
+            return false;
+        }
+    }
+    for (size_t i = prefix_bytes + 9U; i < prefix_bytes + 17U; i++) {
+        if (!g_ascii_isxdigit(name[i])) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static bool migration_recover_quarantine(
+    const XboxSaveMigrationRequest *request, bool *recovered, Error **errp)
+{
+    XboxMigrationSource candidate = { .fd = -1 };
+    g_autofree char *basename = NULL;
+    g_autofree char *candidate_name = NULL;
+    DIR *listing = NULL;
+    int parent_fd = -1;
+    int listing_fd = -1;
+    int listing_flags = O_RDONLY | O_DIRECTORY | O_CLOEXEC;
+    bool success = false;
+
+    *recovered = false;
+    if (!migration_parent_open_private(request->legacy_hdd, &parent_fd,
+                                       &basename, errp) ||
+        !migration_cleanup_empty_quarantines(parent_fd, errp)) {
+        goto done;
+    }
+#ifdef O_NOFOLLOW
+    listing_flags |= O_NOFOLLOW;
+#endif
+    listing_fd = openat(parent_fd, ".", listing_flags);
+    if (listing_fd < 0 || !(listing = fdopendir(listing_fd))) {
+        error_setg_errno(errp, errno,
+                         "Could not inspect Xbox HDD removal quarantine");
+        goto done;
+    }
+    listing_fd = -1;
+    for (;;) {
+        XboxMigrationSource observed = { .fd = -1 };
+        Error *candidate_error = NULL;
+        GStatBuf status;
+        struct dirent *entry;
+        int flags = O_RDWR | O_BINARY;
+        int lock_result;
+
+        errno = 0;
+        entry = readdir(listing);
+        if (!entry) {
+            break;
+        }
+        if (!migration_quarantine_name_valid(entry->d_name)) {
+            continue;
+        }
+#ifdef O_NOFOLLOW
+        flags |= O_NOFOLLOW;
+#endif
+        observed.fd = openat(parent_fd, entry->d_name, flags);
+        observed.path = request->legacy_hdd;
+        if (observed.fd < 0 || fstat(observed.fd, &status) != 0 ||
+            !S_ISREG(status.st_mode) || status.st_uid != geteuid() ||
+            status.st_nlink != 1 ||
+            (status.st_mode & (S_IRWXG | S_IRWXO)) != 0 ||
+            status.st_size < 0 ||
+            (uint64_t)status.st_size != request->expected_source_bytes) {
+            if (observed.fd >= 0) {
+                qemu_close(observed.fd);
+            }
+            continue;
+        }
+        observed.identity = status;
+        lock_result = qemu_lock_fd(observed.fd, 0, 0, true);
+        if (lock_result != 0) {
+            qemu_close(observed.fd);
+            error_setg_errno(errp, -lock_result,
+                             "Could not lock quarantined Xbox HDD");
+            goto done;
+        }
+        if (!migration_source_identity_digest(&observed,
+                                               &candidate_error) ||
+            !migration_source_identity_unchanged(&observed, false, true,
+                                                 &candidate_error)) {
+            qemu_close(observed.fd);
+            error_propagate(errp, candidate_error);
+            goto done;
+        }
+        if (candidate.fd >= 0) {
+            qemu_close(observed.fd);
+            error_setg(errp,
+                       "Multiple Xbox HDD removal quarantines are valid");
+            goto done;
+        }
+        candidate = observed;
+        candidate_name = g_strdup(entry->d_name);
+    }
+    if (errno != 0) {
+        error_setg_errno(errp, errno,
+                         "Could not inspect Xbox HDD removal quarantine");
+        goto done;
+    }
+    if (candidate.fd < 0) {
+        success = true;
+        goto done;
+    }
+    {
+        GStatBuf status;
+
+        if (fstatat(parent_fd, basename, &status,
+                    AT_SYMLINK_NOFOLLOW) == 0 || errno != ENOENT) {
+            error_setg(errp,
+                       "Legacy Xbox HDD path reappeared during recovery");
+            goto done;
+        }
+        if (!migration_source_identity_unchanged(&candidate, false, true,
+                                                 errp) ||
+            renameat(parent_fd, candidate_name, parent_fd, basename) != 0 ||
+            !migration_source_identity_unchanged(&candidate, false, false,
+                                                 errp) ||
+            qemu_fdatasync(parent_fd) != 0) {
+            if (!*errp) {
+                error_setg_errno(errp, errno,
+                                 "Could not restore quarantined Xbox HDD");
+            }
+            goto done;
+        }
+    }
+    *recovered = true;
+    success = true;
+done:
+    if (listing) {
+        closedir(listing);
+    } else if (listing_fd >= 0) {
+        qemu_close(listing_fd);
+    }
+    if (candidate.fd >= 0) {
+        qemu_close(candidate.fd);
+    }
+    if (parent_fd >= 0) {
+        qemu_close(parent_fd);
+    }
+    return success;
+}
+#endif
+
+static bool migration_execute_internal(const XboxSaveMigrationRequest *request,
+                                       XboxSaveMigrationProof *proof,
+                                       bool allow_receipt, Error **errp)
+{
+    XboxMigrationSource source = { .fd = -1 };
+    XboxMigrationSource clean = { .fd = -1 };
+    XboxMigrationVerifyContext verify = { &source, &clean };
+    XboxSaveReceipt receipt;
+    g_autofree char *source_block_path = NULL;
+    g_autofree char *clean_block_path = NULL;
+    BlockBackend *source_blk = NULL;
+    BlockBackend *clean_blk = NULL;
+    XboxSaveVaultIo source_io;
+    XboxSaveVaultIo clean_io;
+    int64_t source_bytes;
+    int64_t clean_bytes;
+    bool receipt_exists;
+    bool receipt_valid;
+    bool vault_found;
+    bool source_projection_complete = false;
+#ifndef _WIN32
+    bool quarantine_recovered = false;
+    GStatBuf legacy_status;
+#endif
+    bool success = false;
+
+    if (!request || !proof || !request->legacy_hdd || !request->clean_hdd ||
+        !request->save_vault ||
+        request->expected_source_bytes == 0U ||
+        !g_path_is_absolute(request->legacy_hdd) ||
+        !g_path_is_absolute(request->clean_hdd) ||
+        !g_path_is_absolute(request->save_vault)) {
+        error_setg(errp, "Xbox save migration request is invalid");
+        return false;
+    }
+    memset(proof, 0, sizeof(*proof));
+#ifndef _WIN32
+    if (g_lstat(request->legacy_hdd, &legacy_status) != 0 &&
+        errno == ENOENT &&
+        !migration_recover_quarantine(request, &quarantine_recovered,
+                                      errp)) {
+        goto done;
+    }
+    if (quarantine_recovered &&
+        g_lstat(request->legacy_hdd, &legacy_status) != 0) {
+        error_setg_errno(errp, errno,
+                         "Recovered Xbox HDD path did not remain available");
+        goto done;
+    }
+#endif
+    if (!migration_source_open_path(request->legacy_hdd, &source, errp)) {
+        goto done;
+    }
+    if ((uint64_t)source.identity.st_size !=
+        request->expected_source_bytes) {
+        error_setg(errp, "Legacy Xbox HDD size does not match expectation");
+        goto done;
+    }
+    if (!migration_source_open_path(request->clean_hdd, &clean, errp) ||
+        !migration_hash_fd(clean.fd, clean.identity.st_size,
+                           clean.digest, errp)) {
+        goto done;
+    }
+    if (!xbox_save_receipt_load(request->save_vault, &receipt,
+                                &receipt_exists, &receipt_valid, errp) ||
+        !xbox_save_vault_try_describe(request->save_vault, &proof->vault,
+                                      &vault_found, errp)) {
+        goto done;
+    }
+    if (allow_receipt && receipt_exists && receipt_valid && vault_found &&
+        migration_receipt_matches(request, &source, &clean,
+                                  &proof->vault, &receipt)) {
+        migration_proof_from_receipt(&source, &clean, &receipt, proof);
+        success = true;
+        goto done;
+    }
+    if (!migration_hash_fd(source.fd, source.identity.st_size,
+                           source.digest, errp)) {
+        goto done;
+    }
+    if (request->expected_source_sha256_valid &&
+        memcmp(source.digest, request->expected_source_sha256,
+               sizeof(source.digest)) != 0) {
+        error_setg(errp, "Legacy Xbox HDD hash does not match expectation");
+        goto done;
+    }
+    source_block_path = migration_bound_block_path(&source);
+    clean_block_path = migration_bound_block_path(&clean);
+    source_blk = migration_open_image(source_block_path, false, true, errp);
+    clean_blk = migration_open_image(clean_block_path, true, true, errp);
+    if (!source_blk || !clean_blk) {
+        goto done;
+    }
+    source_bytes = blk_getlength(source_blk);
+    clean_bytes = blk_getlength(clean_blk);
+    if (source_bytes < 0 || clean_bytes < 0) {
+        error_setg(errp, "Could not read Xbox HDD virtual size");
+        goto done;
+    }
+    if (!xbox_volatile_hdd_attach_clean(clean_blk, errp) ||
+        blk_set_perm(clean_blk,
+                     BLK_PERM_CONSISTENT_READ | BLK_PERM_WRITE,
+                     BLK_PERM_ALL, errp) < 0) {
+        goto done;
+    }
+    source_io = (XboxSaveVaultIo) {
+        .opaque = source_blk,
+        .read = migration_blk_read,
+        .disk_bytes = source_bytes,
+    };
+    clean_io = (XboxSaveVaultIo) {
+        .opaque = clean_blk,
+        .read = migration_blk_read,
+        .write = migration_blk_write,
+        .disk_bytes = clean_bytes,
+    };
+    if (!xbox_save_vault_migrate(
+            request->save_vault, &source_io, &clean_io,
+            migration_verify_images, &verify, &proof->vault,
+            &source_projection_complete, errp)) {
+        goto done;
+    }
+    proof->source_bytes = source.identity.st_size;
+    memcpy(proof->source_identity_sha256, source.identity_digest,
+           sizeof(proof->source_identity_sha256));
+    memcpy(proof->source_sha256, source.digest,
+           sizeof(proof->source_sha256));
+    proof->clean_bytes = clean.identity.st_size;
+    memcpy(proof->clean_sha256, clean.digest,
+           sizeof(proof->clean_sha256));
+    proof->source_writes = false;
+    proof->source_hashed = true;
+    proof->anonymous_cow = true;
+    proof->clean_backing = true;
+    proof->receipt_reused = false;
+    proof->source_projection_complete = source_projection_complete;
+    proof->source_removal_safe = source_projection_complete &&
+        proof->vault.unclassified_tdata_entries == 0U;
+    proof->source_removed = false;
+    migration_receipt_from_proof(&source, &clean, proof, &receipt);
+    if (!xbox_save_receipt_store(request->save_vault, &receipt, errp)) {
+        goto done;
+    }
+    success = true;
+done:
+    if (clean_blk) {
+        blk_unref(clean_blk);
+    }
+    if (source_blk) {
+        blk_unref(source_blk);
+    }
+    if (source.fd >= 0) {
+        qemu_close(source.fd);
+    }
+    if (clean.fd >= 0) {
+        qemu_close(clean.fd);
+    }
+    return success;
+}
+
+static bool migration_source_open_for_removal(
+    const char *path, XboxMigrationSource *source, Error **errp)
+{
+#ifdef _WIN32
+    int flags = O_RDONLY | O_BINARY;
+    g_autofree gunichar2 *wide = NULL;
+    HANDLE handle;
+    FILE_ATTRIBUTE_TAG_INFO attributes;
+
+    memset(source, 0, sizeof(*source));
+    source->fd = -1;
+    source->path = path;
+    if (!path || !g_path_is_absolute(path) ||
+        !(wide = g_utf8_to_utf16(path, -1, NULL, NULL, NULL))) {
+        error_setg(errp, "Xbox HDD removal path is invalid");
+        return false;
+    }
+    handle = CreateFileW((LPCWSTR)wide, GENERIC_READ | DELETE,
+                         FILE_SHARE_READ, NULL, OPEN_EXISTING,
+                         FILE_ATTRIBUTE_NORMAL |
+                         FILE_FLAG_OPEN_REPARSE_POINT, NULL);
+    if (handle == INVALID_HANDLE_VALUE ||
+        !GetFileInformationByHandleEx(handle, FileAttributeTagInfo,
+                                      &attributes, sizeof(attributes)) ||
+        (attributes.FileAttributes & FILE_ATTRIBUTE_REPARSE_POINT) != 0) {
+        if (handle != INVALID_HANDLE_VALUE) {
+            CloseHandle(handle);
+        }
+        error_setg_win32(errp, GetLastError(),
+                         "Could not securely open Xbox HDD for removal");
+        return false;
+    }
+    source->fd = _open_osfhandle((intptr_t)handle, flags);
+    if (source->fd < 0) {
+        CloseHandle(handle);
+        error_setg_errno(errp, errno,
+                         "Could not bind Xbox HDD removal handle");
+        return false;
+    }
+    if (fstat(source->fd, &source->identity) != 0 ||
+        !S_ISREG(source->identity.st_mode) ||
+        source->identity.st_size < 0 ||
+        !migration_source_path_matches(source, errp)) {
+        if (!*errp) {
+            error_setg(errp, "Xbox HDD removal source is unsafe");
+        }
+        return false;
+    }
+    return migration_source_identity_digest(source, errp);
+#else
+    int flags = O_RDWR | O_BINARY;
+    int lock_result;
+
+    memset(source, 0, sizeof(*source));
+    source->fd = -1;
+    source->path = path;
+    if (!path || !g_path_is_absolute(path)) {
+        error_setg(errp, "Xbox HDD removal path is invalid");
+        return false;
+    }
+#ifdef O_NOFOLLOW
+    flags |= O_NOFOLLOW;
+#endif
+    source->fd = qemu_open(path, flags, errp);
+    if (source->fd < 0) {
+        return false;
+    }
+    if (fstat(source->fd, &source->identity) != 0 ||
+        !S_ISREG(source->identity.st_mode) ||
+        (source->identity.st_mode & (S_IRWXG | S_IRWXO)) != 0 ||
+        source->identity.st_size < 0 ||
+        !migration_source_path_matches(source, errp)) {
+        if (!*errp) {
+            error_setg(errp, "Xbox HDD removal source is unsafe");
+        }
+        return false;
+    }
+    lock_result = qemu_lock_fd(source->fd, 0, 0, true);
+    if (lock_result != 0) {
+        error_setg_errno(errp, -lock_result,
+                         "Could not exclusively lock Xbox HDD for removal");
+        return false;
+    }
+    return migration_source_identity_digest(source, errp);
+#endif
+}
