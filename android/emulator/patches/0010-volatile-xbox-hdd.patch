diff --git a/include/block/xbox-save-migration.h b/include/block/xbox-save-migration.h
new file mode 100644
index 0000000000..bd67052d08
--- /dev/null
+++ b/include/block/xbox-save-migration.h
@@ -0,0 +1,81 @@
+/*
+ * Original Xbox legacy HDD save migration
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef XBOX_SAVE_MIGRATION_H
+#define XBOX_SAVE_MIGRATION_H
+
+#include "block/xbox-save-vault.h"
+
+typedef struct XboxSaveMigrationRequest {
+    const char *legacy_hdd;
+    const char *clean_hdd;
+    const char *save_vault;
+    uint64_t expected_source_bytes;
+    uint8_t expected_source_sha256[32];
+    bool expected_source_sha256_valid;
+} XboxSaveMigrationRequest;
+
+typedef struct XboxSaveMigrationProof {
+    uint64_t source_bytes;
+    uint8_t source_identity_sha256[32];
+    uint8_t source_sha256[32];
+    uint64_t clean_bytes;
+    uint8_t clean_sha256[32];
+    XboxSaveVaultProof vault;
+    bool source_writes;
+    bool source_hashed;
+    bool anonymous_cow;
+    bool clean_backing;
+    bool receipt_reused;
+    bool source_projection_complete;
+    bool source_removal_safe;
+    bool source_removed;
+} XboxSaveMigrationProof;
+
+typedef struct XboxSaveMigrationSourceSnapshot {
+    void *opaque;
+    uint64_t bytes;
+    uint8_t identity_sha256[32];
+    uint8_t sha256[32];
+} XboxSaveMigrationSourceSnapshot;
+
+#define XBOX_SAVE_MIGRATION_SOURCE_SNAPSHOT_INIT { 0 }
+
+bool xbox_save_migration_source_snapshot_open(
+    const char *path, XboxSaveMigrationSourceSnapshot *snapshot,
+    Error **errp);
+bool xbox_save_migration_source_snapshot_verify(
+    XboxSaveMigrationSourceSnapshot *snapshot, Error **errp);
+void xbox_save_migration_source_snapshot_close(
+    XboxSaveMigrationSourceSnapshot *snapshot);
+
+/*
+ * Block modules and the main AIO context must be initialized by the caller.
+ * A fresh migration removes the exact legacy source only after a zero
+ * unclassified-TDATA proof. A matching receipt with unclassified TDATA skips
+ * the source hash and preserves the source. A zero-unclassified receipt never
+ * authorizes removal; if its source still exists, migration is freshly
+ * reverified before completing removal.
+ */
+bool xbox_save_migration_execute(const XboxSaveMigrationRequest *request,
+                                 XboxSaveMigrationProof *proof,
+                                 Error **errp);
+
+/*
+ * Performs a forced-fresh recovery migration and removes the exact source only after
+ * full source re-verification, clean-COW roundtrip verification, and a zero
+ * unclassified-TDATA proof. A receipt can never authorize this operation.
+ */
+bool xbox_save_migration_execute_and_remove(
+    const XboxSaveMigrationRequest *request, XboxSaveMigrationProof *proof,
+    Error **errp);
+
+bool xbox_save_vault_validation_execute(const char *save_vault,
+                                        const char *clean_hdd,
+                                        XboxSaveVaultProof *proof,
+                                        Error **errp);
+
+#endif
diff --git a/include/block/xbox-save-policy.h b/include/block/xbox-save-policy.h
new file mode 100644
index 0000000000..eff169cdac
--- /dev/null
+++ b/include/block/xbox-save-policy.h
@@ -0,0 +1,58 @@
+/*
+ * Reviewed Original Xbox TDATA save projection policy
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef XBOX_SAVE_POLICY_H
+#define XBOX_SAVE_POLICY_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#define XBOX_SAVE_POLICY_REVISION 1U
+#define XBOX_SAVE_POLICY_DIGEST_BYTES 32U
+
+typedef enum XboxSavePolicyRuleKind {
+    XBOX_SAVE_POLICY_EXACT_FILE = 1,
+    XBOX_SAVE_POLICY_REVIEWED_SUBTREE = 2,
+} XboxSavePolicyRuleKind;
+
+typedef struct XboxSavePolicyRule {
+    /* Eight lowercase hexadecimal digits. */
+    const char *title_id;
+    /* FATX path relative to E:\\TDATA\\<title_id>. */
+    const char *relative_path;
+    XboxSavePolicyRuleKind kind;
+    /* Stable public evidence identifying this path as player save/profile. */
+    const char *provenance;
+} XboxSavePolicyRule;
+
+typedef struct XboxSavePolicy {
+    uint32_t revision;
+    const XboxSavePolicyRule *rules;
+    size_t rule_count;
+} XboxSavePolicy;
+
+/*
+ * The initial reviewed catalog is deliberately empty. Community reports prove
+ * that some titles use TDATA for saves, but they do not provide sufficiently
+ * authoritative, exhaustive path classification to distinguish those files
+ * from DLC, updates, caches, music, or modified game assets. Adding a rule
+ * requires an exact title/path and public provenance review.
+ */
+const XboxSavePolicy *xbox_save_policy_default(void);
+const XboxSavePolicy *xbox_save_policy_lookup(
+    uint32_t revision,
+    const uint8_t digest[XBOX_SAVE_POLICY_DIGEST_BYTES]);
+bool xbox_save_policy_is_valid(const XboxSavePolicy *policy);
+
+void xbox_save_policy_digest(const XboxSavePolicy *policy,
+                             uint8_t digest[XBOX_SAVE_POLICY_DIGEST_BYTES]);
+bool xbox_save_policy_allows_file(const XboxSavePolicy *policy,
+                                  const char *tdata_path);
+bool xbox_save_policy_needs_directory(const XboxSavePolicy *policy,
+                                      const char *tdata_path);
+
+#endif
