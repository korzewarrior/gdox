+/*
+ * Original Xbox legacy HDD save migration
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+
+#include "block/block-global-state.h"
+#include "block/block_int.h"
+#include "block/xbox-save-migration.h"
+#include "block/xbox-save-receipt.h"
+#include "block/xbox-save-policy.h"
+#include "block/xbox-volatile-hdd.h"
+#include "qapi/error.h"
+#include "qemu/cutils.h"
+#include "qobject/qdict.h"
+#include "system/block-backend.h"
+#include "system/block-backend-io.h"
+
+#include <glib/gstdio.h>
+
+#ifdef _WIN32
+#include <windows.h>
+#include <io.h>
+#endif
+
+#define MIGRATION_HASH_BUFFER_BYTES MiB
+
+typedef struct XboxMigrationSource {
+    const char *path;
+    int fd;
+    GStatBuf identity;
+    uint8_t identity_digest[32];
+    uint8_t digest[32];
+} XboxMigrationSource;
+
+#ifndef _WIN32
+static bool migration_parent_open_private(const char *path, int *parent_fd,
+                                          char **basename, Error **errp);
+static bool migration_cleanup_empty_quarantines(int parent_fd,
+                                                Error **errp);
+#endif
+
+static bool migration_source_identity_digest(XboxMigrationSource *source,
+                                              Error **errp)
+{
+    g_autoptr(GChecksum) checksum = g_checksum_new(G_CHECKSUM_SHA256);
+    g_autofree char *canonical = g_canonicalize_filename(source->path, NULL);
+    uint8_t number[8];
+    const uint8_t separator = 0U;
+    gsize digest_bytes = sizeof(source->identity_digest);
+
+#ifdef _WIN32
+    g_autofree char *folded = g_utf8_casefold(canonical, -1);
+    BY_HANDLE_FILE_INFORMATION info;
+    FILE_BASIC_INFO basic;
+    HANDLE handle = (HANDLE)_get_osfhandle(source->fd);
+
+    if (handle == INVALID_HANDLE_VALUE ||
+        !GetFileInformationByHandle(handle, &info) ||
+        !GetFileInformationByHandleEx(handle, FileBasicInfo,
+                                      &basic, sizeof(basic))) {
+        error_setg_win32(errp, GetLastError(),
+                         "Could not identify Xbox HDD image");
+        return false;
+    }
+
+    g_checksum_update(checksum, (const uint8_t *)"windows-file-v1", 15U);
+    g_checksum_update(checksum, &separator, 1U);
+    g_checksum_update(checksum, (const uint8_t *)folded, strlen(folded));
+    g_checksum_update(checksum, &separator, 1U);
+    stq_le_p(number, info.dwVolumeSerialNumber);
+    g_checksum_update(checksum, number, sizeof(number));
+    stq_le_p(number, ((uint64_t)info.nFileIndexHigh << 32U) |
+                     info.nFileIndexLow);
+    g_checksum_update(checksum, number, sizeof(number));
+    stq_le_p(number, ((uint64_t)info.nFileSizeHigh << 32U) |
+                     info.nFileSizeLow);
+    g_checksum_update(checksum, number, sizeof(number));
+    stq_le_p(number, basic.LastWriteTime.QuadPart);
+    g_checksum_update(checksum, number, sizeof(number));
+    stq_le_p(number, basic.ChangeTime.QuadPart);
+    g_checksum_update(checksum, number, sizeof(number));
+#else
+    g_checksum_update(checksum, (const uint8_t *)"posix-file-v1", 13U);
+    g_checksum_update(checksum, &separator, 1U);
+    g_checksum_update(checksum, (const uint8_t *)canonical,
+                      strlen(canonical));
+    g_checksum_update(checksum, &separator, 1U);
+    stq_le_p(number, source->identity.st_dev);
+    g_checksum_update(checksum, number, sizeof(number));
+    stq_le_p(number, source->identity.st_ino);
+    g_checksum_update(checksum, number, sizeof(number));
+    stq_le_p(number, source->identity.st_size);
+    g_checksum_update(checksum, number, sizeof(number));
+    stq_le_p(number, source->identity.st_mtime);
+    g_checksum_update(checksum, number, sizeof(number));
+    stq_le_p(number, source->identity.st_ctime);
+    g_checksum_update(checksum, number, sizeof(number));
+#if defined(__APPLE__)
+    stq_le_p(number, source->identity.st_mtimespec.tv_nsec);
+    g_checksum_update(checksum, number, sizeof(number));
+    stq_le_p(number, source->identity.st_ctimespec.tv_nsec);
+    g_checksum_update(checksum, number, sizeof(number));
+#elif defined(__linux__) || defined(__FreeBSD__) || defined(__NetBSD__) || \
+      defined(__OpenBSD__)
+    stq_le_p(number, source->identity.st_mtim.tv_nsec);
+    g_checksum_update(checksum, number, sizeof(number));
+    stq_le_p(number, source->identity.st_ctim.tv_nsec);
+    g_checksum_update(checksum, number, sizeof(number));
+#endif
+#endif
+    g_checksum_get_digest(checksum, source->identity_digest, &digest_bytes);
+    g_assert_cmpuint(digest_bytes, ==, sizeof(source->identity_digest));
+    return true;
+}
+
+static bool migration_hash_fd(int fd, uint64_t bytes, uint8_t digest[32],
+                              Error **errp)
+{
+    g_autoptr(GChecksum) checksum = g_checksum_new(G_CHECKSUM_SHA256);
+    g_autofree uint8_t *buffer = g_try_malloc(MIGRATION_HASH_BUFFER_BYTES);
+    uint64_t remaining = bytes;
+    gsize digest_bytes = 32U;
+
+    if (!buffer) {
+        error_setg(errp, "Could not allocate Xbox HDD hash buffer");
+        return false;
+    }
+    if (lseek(fd, 0, SEEK_SET) < 0) {
+        error_setg_errno(errp, errno, "Could not seek Xbox HDD image");
+        return false;
+    }
+    while (remaining > 0U) {
+        size_t wanted = MIN(remaining, (uint64_t)MIGRATION_HASH_BUFFER_BYTES);
+        ssize_t received = RETRY_ON_EINTR(read(fd, buffer, wanted));
+
+        if (received < 0) {
+            error_setg_errno(errp, errno, "Could not hash Xbox HDD image");
+            return false;
+        }
+        if (received == 0) {
+            error_setg(errp, "Xbox HDD image changed while hashing");
+            return false;
+        }
+        g_checksum_update(checksum, buffer, received);
+        remaining -= received;
+    }
+    if (RETRY_ON_EINTR(read(fd, buffer, 1U)) != 0) {
+        error_setg(errp, "Xbox HDD image size changed while hashing");
+        return false;
+    }
+    g_checksum_get_digest(checksum, digest, &digest_bytes);
+    if (digest_bytes != 32U) {
+        error_setg(errp, "Could not finalize Xbox HDD image hash");
+        return false;
+    }
+    return true;
+}
+
+static bool migration_source_path_matches(XboxMigrationSource *source,
+                                           Error **errp)
+{
+    GStatBuf status;
+
+    if (g_lstat(source->path, &status) != 0 ||
+        !S_ISREG(status.st_mode) || S_ISLNK(status.st_mode)) {
+        error_setg(errp, "Xbox HDD image path is no longer a regular file");
+        return false;
+    }
+#ifndef _WIN32
+    if (status.st_uid != geteuid() || status.st_nlink != 1 ||
+        status.st_dev != source->identity.st_dev ||
+        status.st_ino != source->identity.st_ino) {
+        error_setg(errp, "Xbox HDD image identity changed");
+        return false;
+    }
+#else
+    if (status.st_dev != source->identity.st_dev ||
+        status.st_ino != source->identity.st_ino) {
+        error_setg(errp, "Xbox HDD image identity changed");
+        return false;
+    }
+#endif
+    return true;
+}
+
+static bool migration_source_identity_unchanged(XboxMigrationSource *source,
+                                                bool match_path,
+                                                bool match_stat_identity,
+                                                Error **errp)
+{
+    XboxMigrationSource observed = *source;
+    GStatBuf status;
+
+    if (fstat(source->fd, &status) != 0 || !S_ISREG(status.st_mode) ||
+        status.st_dev != source->identity.st_dev ||
+        status.st_ino != source->identity.st_ino ||
+        status.st_size != source->identity.st_size ||
+        status.st_mode != source->identity.st_mode ||
+        (match_path && !migration_source_path_matches(source, errp))) {
+        if (!*errp) {
+            error_setg(errp, "Xbox HDD image identity changed");
+        }
+        return false;
+    }
+#ifndef _WIN32
+    if (status.st_uid != source->identity.st_uid ||
+        status.st_gid != source->identity.st_gid ||
+        status.st_nlink != source->identity.st_nlink ||
+        status.st_rdev != source->identity.st_rdev) {
+        error_setg(errp, "Xbox HDD image identity changed");
+        return false;
+    }
+#endif
+    observed.identity = status;
+    if (match_stat_identity &&
+        (!migration_source_identity_digest(&observed, errp) ||
+         memcmp(observed.identity_digest, source->identity_digest,
+                sizeof(observed.identity_digest)) != 0)) {
+        if (!*errp) {
+            error_setg(errp, "Xbox HDD image identity changed");
+        }
+        return false;
+    }
+    return true;
+}
+
+static bool migration_source_verify(void *opaque, Error **errp)
+{
+    XboxMigrationSource *source = opaque;
+    GStatBuf status;
+    uint8_t digest[32];
+
+    if (fstat(source->fd, &status) != 0 || !S_ISREG(status.st_mode) ||
+        status.st_size != source->identity.st_size ||
+        !migration_source_path_matches(source, errp) ||
+        !migration_hash_fd(source->fd, status.st_size, digest, errp) ||
+        !migration_source_identity_unchanged(source, true, true, errp)) {
+        if (!*errp) {
+            error_setg(errp, "Xbox HDD image identity changed");
+        }
+        return false;
+    }
+    if (memcmp(digest, source->digest, sizeof(digest)) != 0) {
+        error_setg(errp, "Xbox HDD image contents changed");
+        return false;
+    }
+    return true;
+}
+
+static bool migration_source_open_path(const char *path,
+                                       XboxMigrationSource *source,
+                                       Error **errp)
+{
+    int flags = O_RDONLY | O_BINARY;
+
+    memset(source, 0, sizeof(*source));
+    source->fd = -1;
+    source->path = path;
+    if (!source->path || !g_path_is_absolute(source->path)) {
+        error_setg(errp, "Xbox HDD image path must be absolute");
+        return false;
+    }
+#ifdef O_NOFOLLOW
+    flags |= O_NOFOLLOW;
+#endif
+#ifdef _WIN32
+    {
+        g_autofree gunichar2 *wide =
+            g_utf8_to_utf16(source->path, -1, NULL, NULL, NULL);
+        HANDLE handle;
+        FILE_ATTRIBUTE_TAG_INFO attributes;
+
+        if (!wide) {
+            error_setg(errp, "Xbox HDD image path is not valid UTF-8");
+            return false;
+        }
+        /*
+         * FILE_SHARE_READ deliberately denies writes, deletion, and rename
+         * replacement until projection and final verification are complete.
+         * The block backend's subsequent read-only path open is therefore
+         * bound to this same file identity.
+         */
+        handle = CreateFileW((LPCWSTR)wide, GENERIC_READ, FILE_SHARE_READ,
+                             NULL, OPEN_EXISTING,
+                             FILE_ATTRIBUTE_NORMAL |
+                             FILE_FLAG_OPEN_REPARSE_POINT, NULL);
+        if (handle == INVALID_HANDLE_VALUE ||
+            !GetFileInformationByHandleEx(handle, FileAttributeTagInfo,
+                                          &attributes, sizeof(attributes)) ||
+            (attributes.FileAttributes & FILE_ATTRIBUTE_REPARSE_POINT) != 0) {
+            if (handle != INVALID_HANDLE_VALUE) {
+                CloseHandle(handle);
+            }
+            error_setg_win32(errp, GetLastError(),
+                             "Could not securely open Xbox HDD image");
+            return false;
+        }
+        source->fd = _open_osfhandle((intptr_t)handle, flags);
+        if (source->fd < 0) {
+            CloseHandle(handle);
+            error_setg_errno(errp, errno,
+                             "Could not bind Xbox HDD image handle");
+            return false;
+        }
+    }
+#else
+    source->fd = qemu_open(source->path, flags, errp);
+    if (source->fd < 0) {
+        return false;
+    }
+#endif
+    if (fstat(source->fd, &source->identity) != 0 ||
+        !S_ISREG(source->identity.st_mode) ||
+        source->identity.st_size < 0 ||
+        !migration_source_path_matches(source, errp)) {
+        if (!*errp) {
+            error_setg(errp, "Xbox HDD image is not a safe regular file");
+        }
+        return false;
+    }
+    return migration_source_identity_digest(source, errp);
+}
+
+bool xbox_save_migration_source_snapshot_open(
+    const char *path, XboxSaveMigrationSourceSnapshot *snapshot,
+    Error **errp)
+{
+    XboxMigrationSource *source;
+
+    if (!snapshot || snapshot->opaque) {
+        error_setg(errp, "Legacy Xbox HDD snapshot state is invalid");
+        return false;
+    }
+    source = g_new0(XboxMigrationSource, 1);
+    source->fd = -1;
+    if (!migration_source_open_path(path, source, errp)) {
+        if (source->fd >= 0) {
+            qemu_close(source->fd);
+        }
+        g_free(source);
+        return false;
+    }
+    if (!migration_hash_fd(source->fd, source->identity.st_size,
+                           source->digest, errp)) {
+        qemu_close(source->fd);
+        g_free(source);
+        return false;
+    }
+    snapshot->opaque = source;
+    snapshot->bytes = source->identity.st_size;
+    memcpy(snapshot->identity_sha256, source->identity_digest,
+           sizeof(snapshot->identity_sha256));
+    memcpy(snapshot->sha256, source->digest, sizeof(snapshot->sha256));
+    return true;
+}
+
+bool xbox_save_migration_source_snapshot_verify(
+    XboxSaveMigrationSourceSnapshot *snapshot, Error **errp)
+{
+    if (!snapshot || !snapshot->opaque) {
+        error_setg(errp, "Legacy Xbox HDD snapshot is not open");
+        return false;
+    }
+    return migration_source_verify(snapshot->opaque, errp);
+}
+
+void xbox_save_migration_source_snapshot_close(
+    XboxSaveMigrationSourceSnapshot *snapshot)
+{
+    XboxMigrationSource *source;
+
+    if (!snapshot || !snapshot->opaque) {
+        return;
+    }
+    source = snapshot->opaque;
+    if (source->fd >= 0) {
+        qemu_close(source->fd);
+    }
+    g_free(source);
+    memset(snapshot, 0, sizeof(*snapshot));
+}
+
+static BlockBackend *migration_open_image(const char *path, bool force_qcow2,
+                                          bool bound_source,
+                                          Error **errp)
+{
+    GStatBuf status;
+    QDict *options = qdict_new();
+    BlockDriverState *bs;
+    BlockBackend *blk;
+
+    if (!path || !g_path_is_absolute(path) ||
+        (!bound_source &&
+         (g_lstat(path, &status) != 0 || !S_ISREG(status.st_mode) ||
+          S_ISLNK(status.st_mode)))) {
+        error_setg(errp, "Xbox HDD backing must be an absolute regular file");
+        qobject_unref(options);
+        return NULL;
+    }
+#ifndef _WIN32
+    if (!bound_source && status.st_uid != geteuid()) {
+        error_setg(errp, "Xbox HDD backing has an unexpected owner");
+        qobject_unref(options);
+        return NULL;
+    }
+#endif
+    if (force_qcow2) {
+        qdict_put_str(options, "driver", "qcow2");
+    }
+    qdict_put_str(options, "file.driver", "file");
+    qdict_put_str(options, "file.filename", path);
+    bs = bdrv_open(NULL, NULL, options, 0, errp);
+    if (!bs) {
+        return NULL;
+    }
+    if (bs->backing || !bs->file) {
+        error_setg(errp,
+                   "Xbox HDD image must not depend on a backing image");
+        bdrv_unref(bs);
+        return NULL;
+    }
+    {
+        BdrvChild *child;
+
+        QLIST_FOREACH(child, &bs->children, next) {
+            if (child != bs->file) {
+                error_setg(errp,
+                           "Xbox HDD image must not use external data files");
+                bdrv_unref(bs);
+                return NULL;
+            }
+        }
+        if (bs->file->bs->backing ||
+            !QLIST_EMPTY(&bs->file->bs->children)) {
+            error_setg(errp,
+                       "Xbox HDD image storage must be a standalone file");
+            bdrv_unref(bs);
+            return NULL;
+        }
+    }
+    if (!bdrv_is_read_only(bs)) {
+        error_setg(errp, "Xbox HDD backing was not opened read-only");
+        bdrv_unref(bs);
+        return NULL;
+    }
+    blk = blk_new(qemu_get_aio_context(), BLK_PERM_CONSISTENT_READ,
+                  BLK_PERM_ALL);
+    if (blk_insert_bs(blk, bs, errp) < 0) {
+        blk_unref(blk);
+        bdrv_unref(bs);
+        return NULL;
+    }
+    bdrv_unref(bs);
+    return blk;
+}
+
+static int migration_blk_read(void *opaque, uint64_t offset,
+                              void *buffer, size_t bytes)
+{
+    return blk_pread(opaque, offset, bytes, buffer, 0);
+}
+
+static int migration_blk_write(void *opaque, uint64_t offset,
+                               const void *buffer, size_t bytes)
+{
+    return blk_pwrite(opaque, offset, bytes, buffer, 0);
+}
+
+typedef struct XboxMigrationVerifyContext {
+    XboxMigrationSource *source;
+    XboxMigrationSource *clean;
+} XboxMigrationVerifyContext;
+
+static bool migration_verify_images(void *opaque, Error **errp)
+{
+    XboxMigrationVerifyContext *context = opaque;
+
+    return migration_source_verify(context->source, errp) &&
+           migration_source_verify(context->clean, errp);
+}
+
+static char *migration_bound_block_path(const XboxMigrationSource *source)
+{
+#if defined(__linux__)
+    return g_strdup_printf("/proc/self/fd/%d", source->fd);
+#elif !defined(_WIN32)
+    return g_strdup_printf("/dev/fd/%d", source->fd);
+#else
+    return g_strdup(source->path);
+#endif
+}
+
+static bool migration_receipt_bindings_match(
+    const XboxSaveMigrationRequest *request,
+    const XboxMigrationSource *source,
+    const XboxMigrationSource *clean,
+    const XboxSaveVaultProof *vault,
+    const XboxSaveReceipt *receipt)
+{
+    const XboxSavePolicy *policy = xbox_save_policy_default();
+    uint8_t policy_digest[XBOX_SAVE_POLICY_DIGEST_BYTES];
+
+    xbox_save_policy_digest(policy, policy_digest);
+    return receipt->source_bytes == (uint64_t)source->identity.st_size &&
+           receipt->source_bytes == request->expected_source_bytes &&
+           memcmp(receipt->source_identity_sha256,
+                  source->identity_digest, 32U) == 0 &&
+           (!request->expected_source_sha256_valid ||
+            memcmp(receipt->source_sha256,
+                   request->expected_source_sha256, 32U) == 0) &&
+           receipt->clean_bytes == (uint64_t)clean->identity.st_size &&
+           memcmp(receipt->clean_sha256, clean->digest, 32U) == 0 &&
+           receipt->capability_schema == XBOX_SAVE_VAULT_CAPABILITY_SCHEMA &&
+           receipt->vault_format_version == vault->vault_version &&
+           receipt->vault_generation == vault->generation &&
+           memcmp(receipt->vault_tree_sha256,
+                  vault->tree_sha256, 32U) == 0 &&
+           receipt->vault_entries == vault->entries &&
+           receipt->vault_logical_bytes == vault->logical_bytes &&
+           receipt->policy_revision == policy->revision &&
+           receipt->policy_revision == vault->policy_revision &&
+           memcmp(receipt->policy_sha256, policy_digest, 32U) == 0 &&
+           memcmp(receipt->policy_sha256,
+                  vault->policy_sha256, 32U) == 0;
+}
+
+static bool migration_receipt_matches(
+    const XboxSaveMigrationRequest *request,
+    const XboxMigrationSource *source,
+    const XboxMigrationSource *clean,
+    const XboxSaveVaultProof *vault,
+    const XboxSaveReceipt *receipt)
+{
+    return receipt->unclassified_tdata_entries > 0U &&
+           migration_receipt_bindings_match(request, source, clean, vault,
+                                             receipt);
+}
+
+static void migration_proof_from_receipt(
+    const XboxMigrationSource *source,
+    const XboxMigrationSource *clean,
+    const XboxSaveReceipt *receipt,
+    XboxSaveMigrationProof *proof)
+{
+    proof->source_bytes = source->identity.st_size;
+    memcpy(proof->source_identity_sha256, source->identity_digest, 32U);
+    memcpy(proof->source_sha256, receipt->source_sha256, 32U);
+    proof->clean_bytes = clean->identity.st_size;
+    memcpy(proof->clean_sha256, clean->digest, 32U);
+    proof->vault.unclassified_tdata_entries =
+        receipt->unclassified_tdata_entries;
+    proof->vault.unclassified_tdata_bytes =
+        receipt->unclassified_tdata_bytes;
+    memcpy(proof->vault.unclassified_tdata_sha256,
+           receipt->unclassified_tdata_sha256, 32U);
+    proof->vault.vault_reopened = true;
+    proof->vault.reprojected = true;
+    proof->vault.roundtrip_verified = true;
+    proof->source_writes = false;
+    proof->source_hashed = false;
+    proof->anonymous_cow = true;
+    proof->clean_backing = true;
+    proof->receipt_reused = true;
+    proof->source_projection_complete = false;
+    proof->source_removal_safe = false;
+    proof->source_removed = false;
+}
+
+static void migration_receipt_from_proof(
+    const XboxMigrationSource *source,
+    const XboxMigrationSource *clean,
+    const XboxSaveMigrationProof *proof,
+    XboxSaveReceipt *receipt)
+{
+    memset(receipt, 0, sizeof(*receipt));
+    memcpy(receipt->source_identity_sha256, source->identity_digest, 32U);
+    receipt->source_bytes = proof->source_bytes;
+    memcpy(receipt->source_sha256, proof->source_sha256, 32U);
+    receipt->clean_bytes = proof->clean_bytes;
+    memcpy(receipt->clean_sha256, proof->clean_sha256, 32U);
+    receipt->capability_schema = XBOX_SAVE_VAULT_CAPABILITY_SCHEMA;
+    receipt->vault_format_version = proof->vault.vault_version;
+    receipt->policy_revision = proof->vault.policy_revision;
+    memcpy(receipt->policy_sha256, proof->vault.policy_sha256, 32U);
+    receipt->vault_generation = proof->vault.generation;
+    memcpy(receipt->vault_tree_sha256, proof->vault.tree_sha256, 32U);
+    receipt->vault_entries = proof->vault.entries;
+    receipt->vault_logical_bytes = proof->vault.logical_bytes;
+    receipt->unclassified_tdata_entries =
+        proof->vault.unclassified_tdata_entries;
+    receipt->unclassified_tdata_bytes =
+        proof->vault.unclassified_tdata_bytes;
+    memcpy(receipt->unclassified_tdata_sha256,
+           proof->vault.unclassified_tdata_sha256, 32U);
+}
