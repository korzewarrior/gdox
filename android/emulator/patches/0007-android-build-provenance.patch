index 5ea5d06..8e15a30 100644
--- a/android/app/build.gradle.kts
+++ b/android/app/build.gradle.kts
@@ -1,4 +1,6 @@
 import java.util.Properties
+import org.gradle.api.artifacts.component.ModuleComponentIdentifier
+import org.gradle.api.artifacts.dsl.LockMode
 import org.jetbrains.kotlin.gradle.dsl.JvmTarget
 
 plugins {
@@ -170,6 +172,41 @@ dependencies {
   }
 }
 
+val gdoxLockedConfigurations = listOf(
+  "debugCompileClasspath",
+  "debugRuntimeClasspath",
+  "debugUnitTestCompileClasspath",
+  "debugUnitTestRuntimeClasspath",
+  "kotlinBuildToolsApiClasspath",
+  "kotlinCompilerClasspath",
+  "releaseCompileClasspath",
+  "releaseRuntimeClasspath"
+)
+
+configurations.configureEach {
+  if (name in gdoxLockedConfigurations) {
+    resolutionStrategy.activateDependencyLocking()
+  }
+}
+
+dependencyLocking {
+  lockMode.set(LockMode.STRICT)
+}
+
+tasks.register("resolveLockedDependencies") {
+  description = "Resolve GDOX build and test dependencies for lock maintenance."
+  doLast {
+    gdoxLockedConfigurations.forEach { configurationName ->
+      configurations.getByName(configurationName)
+        .incoming.artifactView {
+          componentFilter { identifier ->
+            identifier is ModuleComponentIdentifier
+          }
+        }.files.files
+    }
+  }
+}
+
 kotlin {
   compilerOptions {
     jvmTarget.set(JvmTarget.JVM_21)
