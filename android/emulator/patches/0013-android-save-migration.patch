diff --git a/android/app/src/main/cpp/gdox_save_migration.c b/android/app/src/main/cpp/gdox_save_migration.c
new file mode 100644
index 0000000000..075a3e8c8a
--- /dev/null
+++ b/android/app/src/main/cpp/gdox_save_migration.c
@@ -0,0 +1,486 @@
+#include "qemu/osdep.h"
+
+#include "block/xbox-save-migration.h"
+#include "gdox_save_migration.h"
+
+#include <sys/stat.h>
+
+#define GDOX_CANONICAL_HDD "xbox_hdd.qcow2"
+#define GDOX_STAGED_HDD "xbox_hdd.clean.qcow2"
+#define GDOX_LEGACY_QCOW2 "hdd.qcow2"
+#define GDOX_LEGACY_RAW "hdd.img"
+#define GDOX_PROMOTION_MARKER "managed_hdd_promotion_v1.complete"
+#define GDOX_PROMOTION_MARKER_CONTENTS "gdox-managed-hdd-promotion-v1\n"
+
+typedef enum GdoxMigrationPhase {
+    GDOX_MIGRATION_UNCONFIGURED,
+    GDOX_MIGRATION_READY,
+    GDOX_MIGRATION_PENDING,
+    GDOX_MIGRATION_EXECUTED,
+    GDOX_MIGRATION_FAILED,
+    GDOX_MIGRATION_FINISHED,
+} GdoxMigrationPhase;
+
+typedef struct GdoxSaveMigrationState {
+    GdoxMigrationPhase phase;
+    int directory_fd;
+    int marker_directory_fd;
+    char *directory;
+    char *active_name;
+    char *active_path;
+    char *legacy_name;
+    char *legacy_path;
+    char *save_vault;
+    struct stat active_identity;
+    struct stat legacy_identity;
+    XboxSaveMigrationRequest request;
+    XboxSaveMigrationProof proof;
+    bool marker_created;
+    char failure[512];
+} GdoxSaveMigrationState;
+
+static GdoxSaveMigrationState migration = {
+    .phase = GDOX_MIGRATION_UNCONFIGURED,
+    .directory_fd = -1,
+    .marker_directory_fd = -1,
+};
+
+G_STATIC_ASSERT(XBOX_SAVE_VAULT_CAPABILITY_SCHEMA == 3U);
+
+static bool same_identity(const struct stat *left, const struct stat *right)
+{
+    return left->st_dev == right->st_dev && left->st_ino == right->st_ino &&
+           left->st_size == right->st_size && left->st_uid == right->st_uid;
+}
+
+static bool exact_active_name(const char *name)
+{
+    return name && (!strcmp(name, GDOX_CANONICAL_HDD) ||
+                    !strcmp(name, GDOX_STAGED_HDD));
+}
+
+static bool exact_legacy_name(const char *name)
+{
+    return !name || !name[0] || !strcmp(name, GDOX_CANONICAL_HDD) ||
+           !strcmp(name, GDOX_LEGACY_QCOW2) ||
+           !strcmp(name, GDOX_LEGACY_RAW);
+}
+
+static bool leaf_status(int directory_fd, const char *name,
+                        struct stat *status, bool *exists, Error **errp)
+{
+    if (fstatat(directory_fd, name, status, AT_SYMLINK_NOFOLLOW) == 0) {
+        *exists = true;
+        return true;
+    }
+    if (errno == ENOENT) {
+        memset(status, 0, sizeof(*status));
+        *exists = false;
+        return true;
+    }
+    error_setg_errno(errp, errno, "Could not inspect managed Xbox storage");
+    return false;
+}
+
+static bool regular_owned_leaf(int directory_fd, const char *name,
+                               struct stat *status, Error **errp)
+{
+    bool exists;
+
+    if (!leaf_status(directory_fd, name, status, &exists, errp)) {
+        return false;
+    }
+    if (!exists || !S_ISREG(status->st_mode) || status->st_uid != geteuid() ||
+        status->st_nlink != 1 || status->st_size <= 0) {
+        error_setg(errp, "Managed Xbox storage is not a safe regular file");
+        return false;
+    }
+    return true;
+}
+
+static bool leaf_absent(int directory_fd, const char *name, Error **errp)
+{
+    struct stat status;
+    bool exists;
+
+    if (!leaf_status(directory_fd, name, &status, &exists, errp)) {
+        return false;
+    }
+    if (exists) {
+        error_setg(errp, "Unexpected managed Xbox storage file is present");
+        return false;
+    }
+    return true;
+}
+
+static int open_owned_directory(const char *path, mode_t required_mode,
+                                Error **errp)
+{
+    struct stat status;
+    int fd = open(path, O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+
+    if (fd < 0) {
+        error_setg_errno(errp, errno, "Could not open managed storage directory");
+        return -1;
+    }
+    if (fstat(fd, &status) != 0 || !S_ISDIR(status.st_mode) ||
+        status.st_uid != geteuid() ||
+        (required_mode && (status.st_mode & 0777) != required_mode)) {
+        error_setg(errp, "Managed storage directory has unsafe ownership or mode");
+        close(fd);
+        return -1;
+    }
+    return fd;
+}
+
+static bool validate_layout(Error **errp)
+{
+    struct stat status;
+    bool exists;
+
+    if (!regular_owned_leaf(migration.directory_fd, migration.active_name,
+                            &migration.active_identity, errp)) {
+        return false;
+    }
+    if (!migration.legacy_name) {
+        return !strcmp(migration.active_name, GDOX_CANONICAL_HDD) &&
+               leaf_absent(migration.directory_fd, GDOX_STAGED_HDD, errp) &&
+               leaf_absent(migration.directory_fd, GDOX_LEGACY_QCOW2, errp) &&
+               leaf_absent(migration.directory_fd, GDOX_LEGACY_RAW, errp);
+    }
+    if (!strcmp(migration.legacy_name, GDOX_CANONICAL_HDD)) {
+        if (strcmp(migration.active_name, GDOX_STAGED_HDD) != 0 ||
+            !leaf_absent(migration.directory_fd, GDOX_LEGACY_QCOW2, errp) ||
+            !leaf_absent(migration.directory_fd, GDOX_LEGACY_RAW, errp)) {
+            return false;
+        }
+    } else if (strcmp(migration.active_name, GDOX_CANONICAL_HDD) != 0) {
+        error_setg(errp, "Managed Xbox storage roles are inconsistent");
+        return false;
+    }
+    if (!regular_owned_leaf(migration.directory_fd, migration.legacy_name,
+                            &migration.legacy_identity, errp)) {
+        return false;
+    }
+    if (!strcmp(migration.legacy_name, GDOX_LEGACY_QCOW2)) {
+        return leaf_absent(migration.directory_fd, GDOX_LEGACY_RAW, errp) &&
+               leaf_absent(migration.directory_fd, GDOX_STAGED_HDD, errp);
+    }
+    if (!strcmp(migration.legacy_name, GDOX_LEGACY_RAW)) {
+        return leaf_absent(migration.directory_fd, GDOX_LEGACY_QCOW2, errp) &&
+               leaf_absent(migration.directory_fd, GDOX_STAGED_HDD, errp);
+    }
+    if (!leaf_status(migration.directory_fd, migration.legacy_name,
+                     &status, &exists, errp) || !exists) {
+        return false;
+    }
+    return true;
+}
+
+static void remember_failure(Error *error)
+{
+    const char *detail = error ? error_get_pretty(error) : NULL;
+
+    g_strlcpy(migration.failure,
+              detail && detail[0] ? detail : "Saved-game migration failed",
+              sizeof(migration.failure));
+    error_free(error);
+    migration.phase = GDOX_MIGRATION_FAILED;
+}
+
+static bool fail_finish(Error **errp, const char *message)
+{
+    const char *detail = errp && *errp ? error_get_pretty(*errp) : message;
+
+    g_strlcpy(migration.failure, detail, sizeof(migration.failure));
+    migration.phase = GDOX_MIGRATION_FAILED;
+    if (errp && !*errp) {
+        error_setg(errp, "%s", message);
+    }
+    return false;
+}
+
+static bool write_all(int fd, const void *buffer, size_t bytes)
+{
+    const uint8_t *cursor = buffer;
+
+    while (bytes > 0) {
+        ssize_t written = RETRY_ON_EINTR(write(fd, cursor, bytes));
+        if (written <= 0) {
+            return false;
+        }
+        cursor += written;
+        bytes -= written;
+    }
+    return true;
+}
+
+static bool create_promotion_marker(Error **errp)
+{
+    static const char contents[] = GDOX_PROMOTION_MARKER_CONTENTS;
+    struct stat status;
+    int fd = openat(migration.marker_directory_fd, GDOX_PROMOTION_MARKER,
+                    O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW | O_CLOEXEC,
+                    0600);
+    bool success;
+
+    if (fd < 0) {
+        error_setg_errno(errp, errno, "Could not create HDD promotion marker");
+        return false;
+    }
+    success = write_all(fd, contents, sizeof(contents) - 1U) &&
+              fchmod(fd, 0600) == 0 && fsync(fd) == 0 &&
+              fstat(fd, &status) == 0 && S_ISREG(status.st_mode) &&
+              status.st_uid == geteuid() && status.st_nlink == 1 &&
+              status.st_size == sizeof(contents) - 1U;
+    if (close(fd) != 0) {
+        success = false;
+    }
+    if (!success || fsync(migration.marker_directory_fd) != 0) {
+        (void)unlinkat(migration.marker_directory_fd,
+                       GDOX_PROMOTION_MARKER, 0);
+        (void)fsync(migration.marker_directory_fd);
+        error_setg_errno(errp, errno ? errno : EIO,
+                         "Could not make HDD promotion marker durable");
+        return false;
+    }
+    return true;
+}
+
+static bool clear_promotion_marker(Error **errp)
+{
+    if (unlinkat(migration.marker_directory_fd,
+                 GDOX_PROMOTION_MARKER, 0) != 0 ||
+        fsync(migration.marker_directory_fd) != 0) {
+        error_setg_errno(errp, errno, "Could not clear HDD promotion marker");
+        return false;
+    }
+    return true;
+}
+
+static bool promote_clean_hdd(Error **errp)
+{
+    struct stat current;
+
+    if (!regular_owned_leaf(migration.directory_fd, GDOX_STAGED_HDD,
+                            &current, errp) ||
+        !same_identity(&current, &migration.active_identity) ||
+        !leaf_absent(migration.directory_fd, GDOX_CANONICAL_HDD, errp)) {
+        error_setg(errp, "Pinned clean HDD changed before promotion");
+        return false;
+    }
+    if (renameat(migration.directory_fd, GDOX_STAGED_HDD,
+                 migration.directory_fd, GDOX_CANONICAL_HDD) != 0 ||
+        fsync(migration.directory_fd) != 0 ||
+        !regular_owned_leaf(migration.directory_fd, GDOX_CANONICAL_HDD,
+                            &current, errp) ||
+        !same_identity(&current, &migration.active_identity)) {
+        if (!*errp) {
+            error_setg_errno(errp, errno ? errno : EIO,
+                             "Could not promote pinned clean HDD");
+        }
+        return false;
+    }
+    return true;
+}
+
+bool gdox_save_migration_configure(const char *directory,
+                                   const char *active_name,
+                                   const char *legacy_name,
+                                   const char *save_vault,
+                                   const char *marker_directory,
+                                   Error **errp)
+{
+    gdox_save_migration_reset();
+    if (!directory || !g_path_is_absolute(directory) ||
+        !exact_active_name(active_name) || !exact_legacy_name(legacy_name) ||
+        !save_vault || !g_path_is_absolute(save_vault)) {
+        error_setg(errp, "Managed Xbox storage configuration is invalid");
+        return false;
+    }
+    migration.directory_fd = open_owned_directory(directory, 0, errp);
+    if (migration.directory_fd < 0) {
+        return false;
+    }
+    migration.directory = g_strdup(directory);
+    migration.active_name = g_strdup(active_name);
+    migration.active_path = g_build_filename(directory, active_name, NULL);
+    migration.save_vault = g_strdup(save_vault);
+    if (legacy_name && legacy_name[0]) {
+        if (!marker_directory || !g_path_is_absolute(marker_directory)) {
+            error_setg(errp, "HDD migration marker directory is invalid");
+            gdox_save_migration_reset();
+            return false;
+        }
+        migration.marker_directory_fd =
+            open_owned_directory(marker_directory, 0700, errp);
+        if (migration.marker_directory_fd < 0) {
+            gdox_save_migration_reset();
+            return false;
+        }
+        migration.legacy_name = g_strdup(legacy_name);
+        migration.legacy_path =
+            g_build_filename(directory, legacy_name, NULL);
+    }
+    if (!validate_layout(errp)) {
+        gdox_save_migration_reset();
+        return false;
+    }
+    if (!migration.legacy_name) {
+        migration.phase = GDOX_MIGRATION_READY;
+        return true;
+    }
+    migration.request = (XboxSaveMigrationRequest) {
+        .legacy_hdd = migration.legacy_path,
+        .clean_hdd = migration.active_path,
+        .save_vault = migration.save_vault,
+        .expected_source_bytes = migration.legacy_identity.st_size,
+        .expected_source_sha256_valid = false,
+    };
+    migration.phase = GDOX_MIGRATION_PENDING;
+    return true;
+}
+
+void gdox_save_migration_execute_for_hdd(const char *path)
+{
+    Error *error = NULL;
+
+    if (migration.phase == GDOX_MIGRATION_READY) {
+        return;
+    }
+    if (migration.phase != GDOX_MIGRATION_PENDING || !path ||
+        strcmp(path, migration.active_path) != 0) {
+        error_setg(&error, "Save migration was not bound to the primary Xbox HDD");
+        remember_failure(error);
+        return;
+    }
+    if (!strcmp(migration.legacy_name, GDOX_CANONICAL_HDD)) {
+        if (!create_promotion_marker(&error)) {
+            remember_failure(error);
+            return;
+        }
+        migration.marker_created = true;
+    }
+    if (!xbox_save_migration_execute(&migration.request,
+                                     &migration.proof, &error)) {
+        struct stat current;
+        bool source_exists = false;
+        Error *ignored = NULL;
+
+        if (migration.marker_created &&
+            leaf_status(migration.directory_fd, migration.legacy_name,
+                        &current, &source_exists, &ignored) &&
+            source_exists) {
+            error_free(ignored);
+            ignored = NULL;
+            (void)clear_promotion_marker(&ignored);
+            migration.marker_created = false;
+        }
+        error_free(ignored);
+        remember_failure(error);
+        return;
+    }
+    migration.phase = GDOX_MIGRATION_EXECUTED;
+}
+
+bool gdox_save_migration_finish(GdoxSaveMigrationStatus *status,
+                                Error **errp)
+{
+    struct stat current;
+    bool source_exists;
+    bool canonical_source;
+
+    if (!status) {
+        return fail_finish(errp, "Save migration result is unavailable");
+    }
+    *status = GDOX_SAVE_MIGRATION_NONE;
+    if (migration.phase == GDOX_MIGRATION_READY) {
+        migration.phase = GDOX_MIGRATION_FINISHED;
+        return true;
+    }
+    if (migration.phase == GDOX_MIGRATION_FAILED) {
+        error_setg(errp, "%s", migration.failure);
+        return false;
+    }
+    if (migration.phase != GDOX_MIGRATION_EXECUTED) {
+        return fail_finish(errp, "Save migration did not run for the primary HDD");
+    }
+    if (migration.proof.source_writes || !migration.proof.anonymous_cow ||
+        !migration.proof.clean_backing ||
+        !migration.proof.vault.vault_reopened ||
+        !migration.proof.vault.reprojected ||
+        !migration.proof.vault.roundtrip_verified ||
+        migration.proof.source_bytes !=
+            (uint64_t)migration.legacy_identity.st_size ||
+        (migration.proof.receipt_reused &&
+         migration.proof.source_removal_safe) ||
+        (migration.proof.source_removal_safe &&
+         (!migration.proof.source_projection_complete ||
+          !migration.proof.source_hashed ||
+          migration.proof.vault.unclassified_tdata_entries != 0U))) {
+        return fail_finish(errp, "Saved-game migration proof is inconsistent");
+    }
+    canonical_source = !strcmp(migration.legacy_name, GDOX_CANONICAL_HDD);
+    if (!leaf_status(migration.directory_fd, migration.legacy_name,
+                     &current, &source_exists, errp)) {
+        return fail_finish(errp, "Could not inspect legacy Xbox HDD result");
+    }
+    if (source_exists) {
+        if (!same_identity(&current, &migration.legacy_identity) ||
+            migration.proof.source_removal_safe ||
+            migration.proof.source_removed) {
+            return fail_finish(errp,
+                               "Legacy Xbox HDD result is inconsistent");
+        }
+        if (migration.marker_created && !clear_promotion_marker(errp)) {
+            return fail_finish(errp, "Could not clear HDD promotion marker");
+        }
+        migration.marker_created = false;
+        *status = GDOX_SAVE_MIGRATION_PRESERVED;
+        migration.phase = GDOX_MIGRATION_FINISHED;
+        return true;
+    }
+    if (!migration.proof.source_removed ||
+        !migration.proof.source_removal_safe ||
+        migration.proof.receipt_reused ||
+        !migration.proof.source_projection_complete ||
+        !migration.proof.source_hashed ||
+        migration.proof.vault.unclassified_tdata_entries != 0U ||
+        fsync(migration.directory_fd) != 0) {
+        return fail_finish(errp, "Legacy Xbox HDD removal is not durable");
+    }
+    if (canonical_source &&
+        (!migration.marker_created || !promote_clean_hdd(errp) ||
+         !clear_promotion_marker(errp))) {
+        return fail_finish(errp, "Clean Xbox HDD promotion needs recovery");
+    }
+    migration.marker_created = false;
+    *status = GDOX_SAVE_MIGRATION_IMPORTED;
+    migration.phase = GDOX_MIGRATION_FINISHED;
+    return true;
+}
+
+const char *gdox_save_migration_last_error(void)
+{
+    return migration.failure[0] ? migration.failure : NULL;
+}
+
+void gdox_save_migration_reset(void)
+{
+    if (migration.directory_fd >= 0) {
+        close(migration.directory_fd);
+    }
+    if (migration.marker_directory_fd >= 0) {
+        close(migration.marker_directory_fd);
+    }
+    g_free(migration.directory);
+    g_free(migration.active_name);
+    g_free(migration.active_path);
+    g_free(migration.legacy_name);
+    g_free(migration.legacy_path);
+    g_free(migration.save_vault);
+    memset(&migration, 0, sizeof(migration));
+    migration.phase = GDOX_MIGRATION_UNCONFIGURED;
+    migration.directory_fd = -1;
+    migration.marker_directory_fd = -1;
+}
