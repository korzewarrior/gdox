+static bool CreateSessionMarker(const std::string& path) {
+  const int descriptor = open(
+      path.c_str(), O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW | O_CLOEXEC,
+      S_IRUSR | S_IWUSR);
+  if (descriptor < 0) return false;
+  struct stat status {};
+  const bool safe = fstat(descriptor, &status) == 0 &&
+      S_ISREG(status.st_mode) && status.st_uid == geteuid() &&
+      status.st_nlink == 1 && status.st_size == 0;
+  const bool synced = safe &&
+      fchmod(descriptor, S_IRUSR | S_IWUSR) == 0 && fsync(descriptor) == 0;
+  const bool closed = close(descriptor) == 0;
+  const bool durable = synced && closed && SyncOwnedParentDirectory(path);
+  if (!durable && safe && closed) {
+    (void)unlink(path.c_str());
+    (void)SyncOwnedParentDirectory(path);
+  }
+  return durable;
+}
+
+static bool RemoveSessionMarker(const std::string& path) {
+  struct stat status {};
+  if (lstat(path.c_str(), &status) != 0 || !S_ISREG(status.st_mode) ||
+      status.st_uid != geteuid() || status.st_nlink != 1) {
+    return false;
+  }
+  return unlink(path.c_str()) == 0 && SyncOwnedParentDirectory(path);
+}
