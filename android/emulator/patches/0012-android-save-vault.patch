+static bool EnsurePrivateDirectory(const std::string& path) {
+  struct stat st {};
+  int directory;
+  bool valid;
+
+  if (path.empty()) return false;
+  if (mkdir(path.c_str(), S_IRWXU) != 0 && errno != EEXIST) return false;
+  directory = open(
+      path.c_str(), O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+  if (directory < 0) return false;
+  valid = fstat(directory, &st) == 0 && S_ISDIR(st.st_mode) &&
+      st.st_uid == geteuid() && fchmod(directory, S_IRWXU) == 0 &&
+      fstat(directory, &st) == 0 && S_ISDIR(st.st_mode) &&
+      st.st_uid == geteuid() && (st.st_mode & 0777) == S_IRWXU;
+  close(directory);
+  return valid;
+}
+
+static bool CanonicalPath(const std::string& path, std::string* output) {
+  char resolved[PATH_MAX];
+
+  if (!output || !realpath(path.c_str(), resolved)) return false;
+  *output = resolved;
+  return true;
+}
+
+static bool IsWithinDirectory(const std::string& root,
+                              const std::string& candidate) {
+  return candidate.size() > root.size() &&
+      candidate.compare(0, root.size(), root) == 0 &&
+      candidate[root.size()] == '/';
+}
+
+static std::string ResolveSaveVault() {
+  const char* internalPath = SDL_AndroidGetInternalStoragePath();
+  std::string internalRoot;
+  std::string current;
+  std::string canonical;
+  static constexpr const char* kComponents[] = {"xemu", "saves", "v1"};
+
+  if (!internalPath || internalPath[0] == '\0' ||
+      !CanonicalPath(internalPath, &internalRoot)) {
+    return {};
+  }
+  current = internalRoot;
+  for (const char* component : kComponents) {
+    current += "/";
+    current += component;
+    if (!EnsurePrivateDirectory(current)) return {};
+  }
+  if (!CanonicalPath(current, &canonical) ||
+      !IsWithinDirectory(internalRoot, canonical)) {
+    return {};
+  }
+  return canonical;
+}
