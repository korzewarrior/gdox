diff --git a/util/qemu-timer.c b/util/qemu-timer.c
index eb2706052..bef3b49b2 100644
--- a/util/qemu-timer.c
+++ b/util/qemu-timer.c
@@ -348,15 +348,43 @@ int qemu_poll_ns(GPollFD *fds, guint nfds, int64_t timeout)
 #else
 
 #ifdef XBOX
-    /* Timers are facilitated by this function. Busy-wait if the deadline is
-     * near, to avoid missing deadlines due to costly sleeps.
+    /*
+     * Short timer deadlines are common while emulating the Xbox. Yield for
+     * most of the interval, then spin only for the final fraction to avoid
+     * scheduler overshoot. Reading the ARM virtual counter avoids a system
+     * call in the remaining spin loop.
      */
-    #define XBOX_BUSYWAIT_THRESHOLD_NS 1250000
+    #define XBOX_BUSYWAIT_THRESHOLD_NS 1250000
+    #define XBOX_BUSYWAIT_TAIL_NS 150000
     if ((0 < timeout) && (timeout < XBOX_BUSYWAIT_THRESHOLD_NS)) {
+        int64_t spin_ns = MIN(timeout, XBOX_BUSYWAIT_TAIL_NS);
+        if (timeout > spin_ns) {
+            int64_t sleep_ns = timeout - spin_ns;
+            struct timespec sleep_time = {
+                .tv_sec = sleep_ns / 1000000000LL,
+                .tv_nsec = sleep_ns % 1000000000LL,
+            };
+            nanosleep(&sleep_time, NULL);
+        }
+
+#if defined(__aarch64__)
+        uint64_t frequency;
+        uint64_t start;
+        asm volatile("mrs %0, cntfrq_el0" : "=r"(frequency));
+        asm volatile("mrs %0, cntvct_el0" : "=r"(start));
+        uint64_t ticks =
+            (uint64_t)spin_ns * frequency / 1000000000ULL;
+        uint64_t end = start + ticks;
+        uint64_t now;
+        do {
+            asm volatile("mrs %0, cntvct_el0" : "=r"(now));
+        } while (now < end);
+#else
         int64_t now = qemu_clock_get_ns(QEMU_CLOCK_REALTIME);
-        int64_t end = now + timeout;
+        int64_t end = now + spin_ns;
         while (now < end) {
             now = qemu_clock_get_ns(QEMU_CLOCK_REALTIME);
         }
+#endif
         timeout = 0;
     }
 #endif
