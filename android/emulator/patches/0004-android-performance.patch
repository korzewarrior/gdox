 static void sleep_ns(int64_t ns);
 
+#ifdef __ANDROID__
+static uint64_t android_virtual_counter(void)
+{
+    uint64_t counter;
+    asm volatile("mrs %0, cntvct_el0" : "=r"(counter));
+    return counter;
+}
+
+static uint64_t android_virtual_counter_frequency(void)
+{
+    uint64_t frequency;
+    asm volatile("mrs %0, cntfrq_el0" : "=r"(frequency));
+    return frequency;
+}
+
+static void android_wait_until_ns(int64_t deadline)
+{
+    const int64_t spin_tail_ns = 150000;
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_REALTIME);
+    int64_t remaining = deadline - now;
+
+    if (remaining > spin_tail_ns) {
+        sleep_ns(remaining - spin_tail_ns);
+        now = qemu_clock_get_ns(QEMU_CLOCK_REALTIME);
+        remaining = deadline - now;
+    }
+    if (remaining <= 0) {
+        return;
+    }
+
+    const uint64_t frequency = android_virtual_counter_frequency();
+    const uint64_t start = android_virtual_counter();
+    const uint64_t ticks =
+        (uint64_t)remaining * frequency / UINT64_C(1000000000);
+    const uint64_t end = start + ticks;
+    while (android_virtual_counter() < end) {
+    }
+}
+#endif
