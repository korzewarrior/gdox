-                fan2_pix[2]);
-        fan_rot = 1;
-    }
-    if (fan_rot < 0 || fan_rot > 2) {
-        fprintf(stderr,
-                "Could not determine triangle fan rotation, got color: R=%d, "
-                "G=%d, B=%d\n",
-                fan_pix[0], fan_pix[1], fan_pix[2]);
-        fan_rot = 1;
-    }
-    props->geom_shader_winding.tri_fan = (fan_rot + 2) % 3;
