-static int calc_offset_from_ndc(float x, float y, int width, int height)
-{
-    int x0 = (int)((x + 1.0f) * width * 0.5f);
-    int y0 = (int)((y + 1.0f) * height * 0.5f);
-
-    x0 = MAX(x0, 0);
-    y0 = MAX(y0, 0);
-    x0 = MIN(x0, width - 1);
-    y0 = MIN(y0, height - 1);
-
-    return y0 * width + x0;
-}
