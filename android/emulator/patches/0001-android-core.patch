+                     "uniform sampler2D u_tex;\n"
+                     "out vec4 out_Color;\n"
+                     "void main() {\n"
+                     "  vec4 c = texture(u_tex, v_uv);\n"
+                     "  out_Color = vec4(c.rgb, 1.0);\n"
+                     "}\n";
