-    while ((err = glGetError()) != GL_NO_ERROR) {
-        fprintf(stderr, "GPU properties OpenGL error 0x%X in %s\n", err,
-                context);
-        if (--limit <= 0) {
-            fprintf(
-                stderr,
-                "Too many OpenGL errors in %s — possible infinite error loop\n",
-                context);
-            break;
-        }
-    }
-}
