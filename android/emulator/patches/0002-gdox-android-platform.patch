+  WORKING_DIRECTORY "${REPO_ROOT}"
+  RESULT_VARIABLE QAPI_GEN_RESULT
+)
+if(NOT QAPI_GEN_RESULT EQUAL 0)
+  message(FATAL_ERROR "QAPI generation failed with code ${QAPI_GEN_RESULT}")
+endif()
