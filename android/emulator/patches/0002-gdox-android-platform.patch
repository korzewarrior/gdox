+list(FILTER XEMU_CORE_SOURCES EXCLUDE REGEX "blockdev-nbd\\.c$")
+list(FILTER XEMU_CORE_SOURCES EXCLUDE REGEX "qemu-keymap\\.c$")
+list(FILTER XEMU_CORE_SOURCES EXCLUDE REGEX "replication\\.c$")
