+static int OpenPhysicalDrive(JNIEnv* env, jobject activity) {
+  jclass activityClass = env->GetObjectClass(activity);
+  if (!activityClass) return -1;
+  jmethodID method = env->GetMethodID(
+      activityClass, "gdoxOpenPhysicalDrive", "()I");
+  if (!method) {
+    env->DeleteLocalRef(activityClass);
+    HasException(env, "gdoxOpenPhysicalDrive lookup");
+    return -1;
+  }
+  jint result = env->CallIntMethod(activity, method);
+  env->DeleteLocalRef(activityClass);
+  if (HasException(env, "gdoxOpenPhysicalDrive")) return -1;
+  return static_cast<int>(result);
+}
+
+static void ClosePhysicalDrive(JNIEnv* env, jobject activity) {
+  jclass activityClass = env->GetObjectClass(activity);
+  if (!activityClass) return;
+  jmethodID method = env->GetMethodID(
+      activityClass, "gdoxClosePhysicalDrive", "()V");
+  if (method) {
+    env->CallVoidMethod(activity, method);
+    HasException(env, "gdoxClosePhysicalDrive");
+  } else {
+    HasException(env, "gdoxClosePhysicalDrive lookup");
+  }
+  env->DeleteLocalRef(activityClass);
+}
+
+static void ApplyTitleProfile(
+    JNIEnv* env,
+    jobject activity,
+    const gdox_qemu_disc_info& info) {
+  jclass activityClass = env->GetObjectClass(activity);
+  if (!activityClass) return;
+  jmethodID method = env->GetMethodID(
+      activityClass, "gdoxApplyTitleProfile", "(JLjava/lang/String;)V");
+  if (!method) {
+    env->DeleteLocalRef(activityClass);
+    HasException(env, "gdoxApplyTitleProfile lookup");
+    return;
+  }
+  jstring title = env->NewStringUTF(info.title);
+  const jlong titleId = info.title_id_present
+      ? static_cast<jlong>(info.title_id)
+      : static_cast<jlong>(-1);
+  env->CallVoidMethod(activity, method, titleId, title);
+  env->DeleteLocalRef(title);
+  env->DeleteLocalRef(activityClass);
+  HasException(env, "gdoxApplyTitleProfile");
+}
+
+static void ShutdownPhysicalDrive() {
+  gdox_qemu_disc_shutdown();
+  JNIEnv* env = GetEnv();
+  jobject activity = GetActivity(env);
+  if (env && activity) {
+    ClosePhysicalDrive(env, activity);
+  }
+  g_physical_disc_prepared = false;
+}
