+  if (path.empty()) return false;
+  if (mkdir(path.c_str(), 0755) == 0) return true;
+  return errno == EEXIST;
+}
+
+static bool FileExists(const std::string& path) {
+  if (path.empty()) return false;
+  struct stat st {};
+  return stat(path.c_str(), &st) == 0;
+}
