index 0000000000000000000000000000000000000000..95d88ef60de05b5f069b031abb6dad2f59ce0c17
--- /dev/null
+++ b/android/app/build.gradle.kts
@@ -0,0 +1,149 @@
+import java.util.Properties
+import org.jetbrains.kotlin.gradle.dsl.JvmTarget
+
+plugins {
+  id("com.android.application")
+  id("org.jetbrains.kotlin.android")
+}
+
+val configuredKeystore = providers.gradleProperty("gdoxKeyProperties").orNull
+  ?: System.getenv("GDOX_ANDROID_KEY_PROPERTIES")
+val keystorePropertiesFile = configuredKeystore?.let(::file)
+  ?: rootProject.file("key.properties")
+val keystoreProperties = Properties()
+val hasKeystoreProperties = keystorePropertiesFile.exists()
+
+if (hasKeystoreProperties) {
+  keystorePropertiesFile.inputStream().use { keystoreProperties.load(it) }
+}
+
+val hasReleaseKeystore = hasKeystoreProperties &&
+  listOf("storeFile", "storePassword", "keyAlias", "keyPassword").all {
+    !keystoreProperties.getProperty(it).isNullOrBlank()
+  }
+
+val gdoxSourceDir = providers.gradleProperty("gdoxSourceDir")
+  .orElse(providers.environmentVariable("GDOX_SOURCE_DIR"))
+  .get()
+val gdoxLibusbSourceDir = providers.gradleProperty("gdoxLibusbSourceDir")
+  .orElse(providers.environmentVariable("GDOX_LIBUSB_SOURCE_DIR"))
+  .get()
+val gdoxSdl2SourceDir = providers.gradleProperty("gdoxSdl2SourceDir")
+  .orElse(providers.environmentVariable("GDOX_SDL2_SOURCE_DIR"))
+  .get()
+
+android {
+  namespace = "org.korze.gdox"
+  compileSdk = 36
+  buildToolsVersion = "36.1.0"
+  ndkVersion = "29.0.14206865"
+
+  defaultConfig {
+    applicationId = "org.korze.gdox"
+    minSdk = 26
+    targetSdk = 36
+
+    versionCode = 1
+    versionName = "0.1.3"
+
+    ndk {
+      abiFilters += listOf("arm64-v8a")
+    }
+
+    externalNativeBuild {
+      cmake {
+        arguments += listOf(
+          "-DXEMU_SKIP_TRACE_GEN=OFF",
+          "-DGDOX_SOURCE_DIR=$gdoxSourceDir",
+          "-DGDOX_LIBUSB_SOURCE_DIR=$gdoxLibusbSourceDir",
+          "-DSDL2_LOCAL_DIR=$gdoxSdl2SourceDir",
+          "-DCMAKE_C_FLAGS_DEBUG=-O2 -g1",
+          "-DCMAKE_CXX_FLAGS_DEBUG=-O2 -g1"
+        )
+        cppFlags += listOf("-std=c++17", "-fexceptions", "-frtti")
+      }
+    }
+  }
+
+  signingConfigs {
+    if (hasReleaseKeystore) {
+      create("release") {
+        storeFile = file(keystoreProperties.getProperty("storeFile"))
+        storePassword = keystoreProperties.getProperty("storePassword")
+        keyAlias = keystoreProperties.getProperty("keyAlias")
+        keyPassword = keystoreProperties.getProperty("keyPassword")
+      }
+    }
+  }
+
+  buildTypes {
+    debug {
+      applicationIdSuffix = ".debug"
+      resValue("string", "app_name", "GDOX")
+      ndk {
+        debugSymbolLevel = "NONE"
+      }
+    }
+    release {
+      resValue("string", "app_name", "GDOX")
+      isMinifyEnabled = false
+      proguardFiles(
+        getDefaultProguardFile("proguard-android-optimize.txt"),
+        "proguard-rules.pro"
+      )
+      if (hasReleaseKeystore) {
+        signingConfig = signingConfigs.getByName("release")
+      }
+    }
+  }
+
+  externalNativeBuild {
+    cmake {
+      path = file("src/main/cpp/CMakeLists.txt")
+      version = "3.30.3"
+    }
+  }
+
+  sourceSets {
+    getByName("main") {
+      manifest.srcFile("$gdoxSourceDir/android/emulator/app/AndroidManifest.xml")
+      java.setSrcDirs(listOf(
+        "$gdoxSourceDir/android/app/src/main/java",
+        "$gdoxSourceDir/android/emulator/app/java",
+        "$gdoxSdl2SourceDir/android-project/app/src/main/java"
+      ))
+      res.setSrcDirs(listOf(
+        "$gdoxSourceDir/android/app/src/main/res",
+        "$gdoxSourceDir/android/emulator/app/res"
+      ))
+    }
+  }
+
+  packaging {
+    resources.excludes += setOf(
+      "**/*.md",
+      "META-INF/LICENSE*",
+      "META-INF/NOTICE*"
+    )
+  }
+
+  compileOptions {
+    sourceCompatibility = JavaVersion.VERSION_21
+    targetCompatibility = JavaVersion.VERSION_21
+  }
+
+}
+
+dependencies {
+  implementation("androidx.core:core-ktx:1.15.0") {
+    // GDOX has no managed baseline profile. Avoid the otherwise transitive
+    // startup provider and DUMP-protected profile maintenance receiver.
+    exclude(group = "androidx.profileinstaller", module = "profileinstaller")
+  }
+}
+
+kotlin {
+  compilerOptions {
+    jvmTarget.set(JvmTarget.JVM_21)
+  }
+}
