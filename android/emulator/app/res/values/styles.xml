<resources>
  <color name="gdox_background">#090C0A</color>
  <color name="gdox_xbox_green">#107C10</color>

  <style name="Theme.Gdox" parent="android:style/Theme.Material.NoActionBar">
    <item name="android:colorAccent">@color/gdox_xbox_green</item>
    <item name="android:fontFamily">sans</item>
    <item name="android:navigationBarColor">@color/gdox_background</item>
    <item name="android:statusBarColor">@color/gdox_background</item>
    <item name="android:windowActionModeOverlay">true</item>
    <item name="android:windowLightNavigationBar">false</item>
    <item name="android:windowLightStatusBar">false</item>
    <item name="android:windowNoTitle">true</item>
  </style>
</resources>
