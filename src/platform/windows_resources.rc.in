#include <windows.h>

1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/packaging/windows/GDOX.ico"

1 VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Korze"
            VALUE "FileDescription", "GDOX original Xbox disc preservation and playback"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "gdox"
            VALUE "LegalCopyright", "Dedicated under the project license"
            VALUE "OriginalFilename", "gdox.exe"
            VALUE "ProductName", "GDOX"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
