/*
 * Canonical Xenia child-process injection policy.
 *
 * Keep hardware-selection variables out of this list. The host Vulkan driver,
 * Steam Input, and Proton discovery remain inherited. Only host-side hooks and
 * layer controls that can interpose on Xenia are removed or replaced.
 */
GDOX_XENIA_INJECTION_UNSET(LD_PRELOAD)
GDOX_XENIA_INJECTION_UNSET(ENABLE_GAMESCOPE_WSI)
GDOX_XENIA_INJECTION_UNSET(VK_INSTANCE_LAYERS)
GDOX_XENIA_INJECTION_UNSET(VK_LAYER_PATH)
GDOX_XENIA_INJECTION_UNSET(VK_ADD_LAYER_PATH)
GDOX_XENIA_INJECTION_UNSET(VK_IMPLICIT_LAYER_PATH)
GDOX_XENIA_INJECTION_UNSET(VK_ADD_IMPLICIT_LAYER_PATH)
GDOX_XENIA_INJECTION_UNSET(VK_LOADER_LAYERS_ENABLE)
GDOX_XENIA_INJECTION_UNSET(VK_LOADER_LAYERS_ALLOW)
GDOX_XENIA_INJECTION_UNSET(MANGOHUD)
GDOX_XENIA_INJECTION_UNSET(MANGOHUD_CONFIG)
GDOX_XENIA_INJECTION_UNSET(MANGOHUD_CONFIGFILE)
GDOX_XENIA_INJECTION_UNSET(MANGOHUD_DLSYM)
GDOX_XENIA_INJECTION_UNSET(MANGOHUD_OUTPUT)
GDOX_XENIA_INJECTION_UNSET(MANGOHUD_LOG_LEVEL)
GDOX_XENIA_INJECTION_UNSET(ENABLE_VKBASALT)
GDOX_XENIA_INJECTION_UNSET(VKBASALT_CONFIG_FILE)
GDOX_XENIA_INJECTION_SET(DISABLE_GAMESCOPE_WSI, 1)
GDOX_XENIA_INJECTION_SET(VK_LOADER_LAYERS_DISABLE, ~implicit~)
